<?xml version="1.0" encoding="utf-8"?>
<!-- ADR-0010: the vault is encrypted with a key that never leaves this
     phone's Keystore, so a restored copy would be unreadable. Nothing is
     backed up or transferred; "Export all data" is the migration path. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
