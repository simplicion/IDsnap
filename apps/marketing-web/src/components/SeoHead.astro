---
export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogType?: string;
  schema?: object | object[];
  robots?: string;
}

const {
  title,
  description,
  canonical,
  ogType = 'website',
  schema,
  robots = 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1',
} = Astro.props;

const siteOrigin = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://idsnap-bi3.pages.dev';
const pagePath = Astro.url.pathname === '/' ? '' : Astro.url.pathname.replace(/\/$/, '');
const rawCanonical = canonical || `${siteOrigin}${pagePath}`;
const resolvedCanonical = rawCanonical.startsWith('http')
  ? rawCanonical
  : `${siteOrigin}${rawCanonical.startsWith('/') ? rawCanonical : '/' + rawCanonical}`;
const siteName = 'IDSnap: Everyday Document & Identity Studio';
const fullTitle = title.includes('IDSnap') ? title : `${title} | IDSnap`;
const ogImage = `${siteOrigin}/og-image.png`;

// Default WebSite & Organization Schema
const defaultSiteSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteOrigin}/#website`,
      "url": siteOrigin,
      "name": "IDSnap",
      "description": "The Private Identity & Document Studio for Android",
      "publisher": {
        "@id": `${siteOrigin}/#organization`
      },
      "inLanguage": "en-US"
    },
    {
      "@type": "Organization",
      "@id": `${siteOrigin}/#organization`,
      "name": "IDSnap",
      "url": siteOrigin,
      "logo": {
        "@type": "ImageObject",
        "url": `${siteOrigin}/logo.svg`,
        "width": "512",
        "height": "512"
      },
      "sameAs": [
        "https://play.google.com/store/apps/details?id=com.idsnap.app&hl=en"
      ]
    }
  ]
};
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={resolvedCanonical} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={resolvedCanonical} />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="IDSnap - The Private Identity & Document Studio" />
<meta property="og:locale" content="en_US" />

<!-- Twitter / X Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={resolvedCanonical} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content="IDSnap - The Private Identity & Document Studio" />

<!-- Favicon and App Icons -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="apple-touch-icon" href="/favicon.svg" />
<meta name="theme-color" content="#2457D6" />
<meta name="color-scheme" content="light dark" />

<!-- Google Search & Crawler Directives -->
<meta name="robots" content={robots} />

<!-- JSON-LD Structured Data -->
{schema ? (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
) : (
  <script type="application/ld+json" set:html={JSON.stringify(defaultSiteSchema)} />
)}

