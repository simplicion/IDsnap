---
import Layout from '../layouts/Layout.astro';

const playStoreUrl = "https://play.google.com/store/apps/details?id=com.idsnap.app&hl=en";

const commonPortals = [
  { name: "Government Recruitment (UPSC / SSC / State PSC)", limit: "PDF ≤ 200 KB or 300 KB", photo: "JPEG ≤ 50 KB" },
  { name: "National Entrance Exams (JEE, NEET, CUET)", limit: "Marksheet PDF ≤ 300 KB", photo: "Photo ≤ 50 KB, Sign ≤ 20 KB" },
  { name: "Banking & KYC Portals", limit: "ID Card / Passbook ≤ 500 KB", photo: "Selfie ≤ 100 KB" },
  { name: "US Visa Form DS-160", limit: "Supporting Docs ≤ 2 MB", photo: "2×2 in Square ≤ 240 KB" },
  { name: "University & College Admissions", limit: "Certificates ≤ 200 KB", photo: "Passport Photo ≤ 50 KB" }
];

const faqItems = [
  {
    question: "How does IDSnap's target-size compressor differ from regular PDF compressors?",
    answer: "Regular compressors ask you to choose vague quality percentages (e.g., 'Low', 'Medium', 'High'). 'High' might output 215 KB (rejected by a 200 KB portal), while 'Low' outputs 40 KB (blurry and illegible). IDSnap's engine uses an intelligent binary search: you tell it 'under 200 KB', and it algorithmically balances DPI and compression levels to get the largest, sharpest possible output strictly under your limit."
  },
  {
    question: "Can I compress both PDFs and images to exact KB sizes?",
    answer: "Yes. IDSnap compresses multi-page PDFs as well as standalone JPEG/PNG images (e.g., portrait photos to under 50 KB, or signatures to under 20 KB) with exact target limits."
  },
  {
    question: "Are my confidential contracts or tax returns uploaded to a cloud compressor?",
    answer: "No. All PDFium and imaging operations run in a local background isolate on your device. Zero bytes are uploaded to remote servers, making IDSnap completely secure for tax records, bank statements, and government IDs."
  },
  {
    question: "Does compressing make text unreadable?",
    answer: "IDSnap prioritizes contrast and edge sharpness for document text. For scanned pages, it uses specialized thresholding so black text on white backgrounds remains crisp even when heavily compressed for 200 KB portals."
  }
];

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to Compress a PDF to Under 200 KB on Android",
  "description": "Step-by-step guide to compress any PDF or document to an exact file size limit like 200 KB or 100 KB using IDSnap.",
  "step": [
    {
      "@type": "HowToStep",
      "name": "Select PDF or Document",
      "text": "Open IDSnap and choose 'Compress to Size' from the Tools menu. Pick your PDF or document from your phone or IDSnap Vault."
    },
    {
      "@type": "HowToStep",
      "name": "Enter your target file size in KB",
      "text": "Type your exact target limit (e.g. 200 KB for exam portals, or select one-tap presets like 100 KB, 200 KB, 300 KB)."
    },
    {
      "@type": "HowToStep",
      "name": "Instant on-device optimization",
      "text": "IDSnap's engine tests compression parameters and generates an output verified to be strictly under your threshold."
    },
    {
      "@type": "HowToStep",
      "name": "Preview and save",
      "text": "Review before-and-after clarity with exact byte readouts. Save or upload directly to your portal."
    }
  ]
};

const pageSchema = [
  howToSchema,
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqItems.map(item => ({
      "@type": "Question",
      "name": item.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": item.answer
      }
    }))
  }
];
---

<Layout
  title="Compress PDF to Exact File Size — Under 200 KB, 100 KB, 50 KB | IDSnap"
  description="Compress PDF and images to exact portal limits (under 200 KB, 100 KB, 50 KB). Zero guesswork, sharp text, 100% on-device private processing on Android."
  schema={pageSchema}
>
  <!-- HERO SECTION -->
  <section class="section tool-hero">
    <div class="container hero-grid">
      <div class="hero-text-col">
        <div class="badge-pill">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="4 14 10 14 10 20"/>
            <polyline points="20 10 14 10 14 4"/>
            <line x1="14" y1="10" x2="21" y2="3"/>
            <line x1="3" y1="21" x2="10" y2="14"/>
          </svg>
          Target Size Search • Exact KB Control • Never Rejected by Portals
        </div>
        <h1 class="hero-title">
          Compress PDF to <span class="gradient-text">Exact Target Size</span>
        </h1>
        <p class="hero-desc">
          Stop guessing between "Low, Medium, High" and praying the upload portal doesn't reject your file. Enter your exact target size—like "Under 200 KB" or "Under 50 KB"—and IDSnap's binary search engine delivers the sharpest possible PDF strictly under your limit, 100% on-device.
        </p>

        <div class="hero-actions">
          <a href={playStoreUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-hero">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M3.609 1.814L13.793 12 3.61 22.186a2.235 2.235 0 0 1-.61-.318c-.469-.34-.75-.89-.75-1.488V3.62c0-.598.281-1.148.75-1.488.196-.142.408-.25.61-.318zm11.603 11.603l2.607-2.607-12.01-6.93 9.403 9.537zm0 1.166l-9.403 9.537 12.01-6.93-2.607-2.607zm1.166-1.166l3.208 1.852c.983.567.983 1.493 0 2.06l-3.208 1.852V13.417z"/>
            </svg>
            Download Free on Google Play
          </a>
          <span class="trust-badge-mini">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#0E8A7E" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            Pure offline processing • No server uploads
          </span>
        </div>
      </div>

      <!-- VISUAL INTERACTIVE SIMULATOR -->
      <div class="hero-visual-col">
        <div class="card-glass compressor-sim-card">
          <div class="sim-header">
            <span class="sim-title">Target Size Engine</span>
            <span class="sim-status">Algorithm: Binary Search</span>
          </div>

          <div class="sim-visual-body">
            <div class="sim-file-box before">
              <span class="file-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                  <polyline points="14 2 14 8 20 8"/>
                </svg>
              </span>
              <span class="file-name">Scanned_Marksheet.pdf</span>
              <span class="file-size red-text">4.8 MB (Too Large)</span>
              <span class="rejection-tag">
                <svg class="icon-inline" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"/>
                  <line x1="15" y1="9" x2="9" y2="15"/>
                  <line x1="9" y1="9" x2="15" y2="15"/>
                </svg>
                Portal Rejection (&gt;200 KB)
              </span>
            </div>

            <div class="sim-arrow-wrap">
              <div class="arrow-line"></div>
              <div class="arrow-badge">Exact 200 KB Target</div>
            </div>

            <div class="sim-file-box after">
              <span class="file-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                  <polyline points="22 4 12 14.01 9 11.01"/>
                </svg>
              </span>
              <span class="file-name">Marksheet_PortalReady.pdf</span>
              <span class="file-size green-text">194.2 KB (96% Saved)</span>
              <span class="approved-tag">
                <svg class="icon-inline" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
                Portal Ready &amp; Legible
              </span>
            </div>
          </div>

          <div class="sim-controls-mock">
            <span class="control-label">Quick Target Presets:</span>
            <div class="preset-pills">
              <button class="pill-btn">50 KB (Photo)</button>
              <button class="pill-btn pill-btn-active">200 KB (Govt Forms)</button>
              <button class="pill-btn">300 KB (Admit Cards)</button>
              <button class="pill-btn">1 MB (Resumes)</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- COMMON PORTALS REQUIREMENTS TABLE -->
  <section class="section portals-section">
    <div class="container">
      <div class="section-header text-center">
        <h2 class="section-title">Pre-Calibrated for Strict Portal Limits</h2>
        <p class="section-desc">
          Official admission portals, public service commissions, and visa systems enforce rigid file sizes.
        </p>
      </div>

      <div class="portals-table-wrap card-glass">
        <table class="portals-table">
          <thead>
            <tr>
              <th>Portal / Examination System</th>
              <th>Document PDF Limit</th>
              <th>Photo / Signature Limit</th>
              <th>IDSnap Solution</th>
            </tr>
          </thead>
          <tbody>
            {commonPortals.map((item) => (
              <tr>
                <td><strong>{item.name}</strong></td>
                <td><span class="pill-limit">{item.limit}</span></td>
                <td><span class="pill-photo">{item.photo}</span></td>
                <td>
                  <span class="check-text">
                    <svg class="icon-inline" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="20 6 9 17 4 12"/>
                    </svg>
                    Exact Target Compressor (1-Tap)
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS TECH EXPLANATION -->
  <section class="section tech-section">
    <div class="container">
      <div class="section-header text-center">
        <div class="badge-pill">The Science of Compression</div>
        <h2 class="section-title">Why Binary Search Beats Percentage Sliders</h2>
      </div>

      <div class="feature-grid-3">
        <div class="card-glass feature-detail-card">
          <div class="feature-icon-badge">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="23 18 13.5 8.5 8.5 13.5 1 6"/>
              <polyline points="17 18 23 18 23 12"/>
            </svg>
          </div>
          <h3 class="feature-detail-title">No More Guesswork</h3>
          <p class="feature-detail-text">
            Traditional apps make you slide a percentage slider (e.g. 70%) and hope for the best. If it outputs 202 KB, your portal rejects it. IDSnap calculates the exact bytes programmatically.
          </p>
        </div>

        <div class="card-glass feature-detail-card">
          <div class="feature-icon-badge">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"/>
              <line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
          </div>
          <h3 class="feature-detail-title">Text Sharpness Preserved</h3>
          <p class="feature-detail-text">
            IDSnap doesn't just blur the entire image. For scanned documents, it sharpens character edges and reduces background paper grain, keeping small numbers and roll numbers 100% readable.
          </p>
        </div>

        <div class="card-glass feature-detail-card">
          <div class="feature-icon-badge">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
          </div>
          <h3 class="feature-detail-title">Private & Client-Side</h3>
          <p class="feature-detail-text">
            Online PDF compressors store your sensitive salary slips, tax forms, and IDs on cloud servers. IDSnap executes all PDF operations entirely in your phone's memory.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- STEP BY STEP GUIDE -->
  <section class="section steps-section">
    <div class="container">
      <div class="section-header text-center">
        <h2 class="section-title">How to Compress Any File in 3 Steps</h2>
      </div>

      <div class="steps-container">
        <div class="step-card">
          <div class="step-number">1</div>
          <h3 class="step-title">Choose File</h3>
          <p class="step-text">Pick your PDF or photo from your device storage, files library, or IDSnap Vault.</p>
        </div>
        <div class="step-card">
          <div class="step-number">2</div>
          <h3 class="step-title">Type Target KB</h3>
          <p class="step-text">Enter your target size (e.g. 200 KB or 50 KB) or choose from one-tap portal presets.</p>
        </div>
        <div class="step-card">
          <div class="step-number">3</div>
          <h3 class="step-title">Export Verified PDF</h3>
          <p class="step-text">Review the before-and-after size comparison and export a document verified to pass upload gates.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ SECTION -->
  <section class="section faq-section">
    <div class="container">
      <div class="section-header text-center">
        <h2 class="section-title">Frequently Asked Questions</h2>
        <p class="section-desc">Got questions about file size reduction? We have answers.</p>
      </div>

      <div class="faq-list">
        {faqItems.map((item) => (
          <div class="card-glass faq-card">
            <h3 class="faq-q">{item.question}</h3>
            <p class="faq-a">{item.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- BOTTOM CTA -->
  <section class="section cta-section">
    <div class="container">
      <div class="card-glass cta-banner text-center">
        <h2 class="cta-title">Compress Documents to Under 200 KB Now</h2>
        <p class="cta-text">
          No ads while a job runs, processing on your phone, and completely free on Google Play (supported by ads).
        </p>
        <div class="cta-buttons">
          <a href={playStoreUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-large">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
              <path d="M3.609 1.814L13.793 12 3.61 22.186a2.235 2.235 0 0 1-.61-.318c-.469-.34-.75-.89-.75-1.488V3.62c0-.598.281-1.148.75-1.488.196-.142.408-.25.61-.318zm11.603 11.603l2.607-2.607-12.01-6.93 9.403 9.537zm0 1.166l-9.403 9.537 12.01-6.93-2.607-2.607zm1.166-1.166l3.208 1.852c.983.567.983 1.493 0 2.06l-3.208 1.852V13.417z"/>
            </svg>
            Download IDSnap on Google Play
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .tool-hero {
    padding-top: 4rem;
    padding-bottom: 5rem;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 3.5rem;
    align-items: center;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: 2.8rem;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin: 1.25rem 0 1rem 0;
  }

  .hero-desc {
    font-size: 1.1rem;
    line-height: 1.65;
    color: var(--on-surface-variant);
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
  }

  .btn-hero {
    padding: 0.85rem 1.75rem;
    font-size: 1.05rem;
    font-weight: 600;
    border-radius: var(--radius-full);
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
  }

  .trust-badge-mini {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--on-surface-variant);
    font-weight: 500;
  }

  /* Compressor Simulator Card */
  .compressor-sim-card {
    padding: 1.75rem;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
  }

  .sim-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }

  .sim-title {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--on-surface);
  }

  .sim-status {
    font-size: 0.8rem;
    color: var(--secondary);
    font-weight: 600;
  }

  .sim-visual-body {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .sim-file-box {
    background: var(--surface);
    border: 1px solid var(--outline-variant);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .sim-file-box.after {
    border-color: #0E8A7E;
    background: rgba(14, 138, 126, 0.04);
  }

  .file-icon {
    font-size: 1.5rem;
    margin-bottom: 0.25rem;
  }

  .file-name {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--on-surface);
  }

  .file-size {
    font-size: 0.85rem;
    font-weight: 700;
  }

  .red-text { color: var(--error); }
  .green-text { color: var(--secondary); }

  .rejection-tag, .approved-tag {
    font-size: 0.75rem;
    font-weight: 600;
    margin-top: 0.25rem;
  }
  .rejection-tag { color: var(--error); }
  .approved-tag { color: var(--secondary); }

  .sim-arrow-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .arrow-badge {
    background: var(--primary-container);
    color: var(--on-primary-container);
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-full);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .sim-controls-mock {
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .control-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--on-surface-variant);
  }

  .preset-pills {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .pill-btn {
    background: var(--surface);
    border: 1px solid var(--outline-variant);
    padding: 0.3rem 0.65rem;
    border-radius: var(--radius-sm);
    font-size: 0.8rem;
    color: var(--on-surface);
    cursor: pointer;
  }

  .pill-btn-active {
    background: var(--primary);
    color: var(--on-primary);
    border-color: var(--primary);
  }

  /* Portals Table */
  .portals-table-wrap {
    overflow-x: auto;
    margin-top: 2.5rem;
    padding: 1.5rem;
    border-radius: var(--radius-lg);
  }

  .portals-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
  }

  .portals-table th {
    text-align: left;
    padding: 0.85rem 1rem;
    border-bottom: 2px solid var(--outline-variant);
    font-size: 0.82rem;
    text-transform: uppercase;
    color: var(--on-surface-variant);
  }

  .portals-table td {
    padding: 1.1rem 1rem;
    border-bottom: 1px solid var(--outline-variant);
  }

  .pill-limit {
    background: rgba(36, 87, 214, 0.1);
    color: var(--primary);
    font-weight: 700;
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-sm);
  }

  .pill-photo {
    background: rgba(14, 138, 126, 0.1);
    color: var(--secondary);
    font-weight: 600;
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-sm);
  }

  .check-text {
    font-weight: 600;
    color: var(--secondary);
  }

  /* Grid details */
  .feature-grid-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
    margin-top: 3rem;
  }

  .feature-detail-card {
    padding: 2rem;
    border-radius: var(--radius-lg);
  }

  .feature-icon-badge {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    background: var(--primary-container);
    color: var(--primary);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  .feature-detail-title {
    font-size: 1.2rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    color: var(--on-surface);
  }

  .feature-detail-text {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--on-surface-variant);
  }

  /* Steps section */
  .steps-container {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 3rem;
  }

  .step-card {
    background: var(--surface);
    border: 1px solid var(--outline-variant);
    border-radius: var(--radius-lg);
    padding: 1.75rem 1.25rem;
  }

  .step-number {
    width: 36px;
    height: 36px;
    background: var(--primary);
    color: var(--on-primary);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 1.1rem;
    margin-bottom: 1rem;
  }

  .step-title {
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--on-surface);
  }

  .step-text {
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--on-surface-variant);
  }

  /* FAQ */
  .faq-list {
    max-width: 820px;
    margin: 2.5rem auto 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .faq-card {
    padding: 1.5rem 1.75rem;
    border-radius: var(--radius-lg);
  }

  .faq-q {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--on-surface);
    margin-bottom: 0.5rem;
  }

  .faq-a {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--on-surface-variant);
  }

  /* CTA */
  .cta-banner {
    padding: 4rem 2rem;
    border-radius: var(--radius-xl);
  }

  .cta-title {
    font-family: var(--font-display);
    font-size: 2.2rem;
    font-weight: 800;
    margin-bottom: 1rem;
  }

  .cta-text {
    font-size: 1.1rem;
    color: var(--on-surface-variant);
    margin-bottom: 2rem;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .btn-large {
