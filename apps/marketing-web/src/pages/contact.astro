---
import Layout from '../layouts/Layout.astro';

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "IDSnap Support & Developer Contact",
  "description": "Official support, feedback, and developer contact page for IDSnap.",
  "mainEntity": {
    "@type": "Organization",
    "name": "IDSnap",
    "email": "support@idsnap.app",
    "url": "https://idsnap.app"
  }
};
---

<Layout
  title="Support & Developer Contact"
  description="Contact the IDSnap development and support team. Get help with scanning, 2FA keys, PDF compression, and security inquiries."
  schema={contactSchema}
>
  <div class="container legal-page-container">
    <div class="legal-header">
      <div class="badge-pill">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
        </svg>
        App Store & Google Play Support
      </div>
      <h1 class="legal-title">Support & Developer Contact</h1>
      <p class="legal-meta">We are here to help. Reach out with questions, bug reports, or feature requests.</p>
    </div>

    <div class="contact-grid">
      <!-- Quick Contact Cards -->
      <div class="card-glass contact-card">
        <div class="card-icon"><svg class="icon-inline" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg></div>
        <h3>General & User Support</h3>
        <p>Questions about scanning, 2FA setup, or PDF export:</p>
        <a href="mailto:support@idsnap.app" class="contact-email-link">support@idsnap.app</a>
        <span class="response-badge">Response within 24h</span>
      </div>

      <div class="card-glass contact-card">
        <div class="card-icon"><svg class="icon-inline" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg></div>
        <h3>Security & Compliance</h3>
        <p>Vulnerability reports, auditor inquiries, or privacy compliance:</p>
        <a href="mailto:security@idsnap.app" class="contact-email-link">security@idsnap.app</a>
        <span class="response-badge">High Priority SLA</span>
      </div>

      <div class="card-glass contact-card">
        <div class="card-icon"><svg class="icon-inline" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg></div>
        <h3>Store & Developer Inquiries</h3>
        <p>App Store, Google Play, or OEM pre-installation questions:</p>
        <a href="mailto:developer@idsnap.app" class="contact-email-link">developer@idsnap.app</a>
        <span class="response-badge">Direct Eng Team</span>
      </div>
    </div>

    <!-- Self-Serve Help Section -->
    <div class="card-glass self-serve-box">
      <h3>Looking for Fast Answers?</h3>
      <p>Before emailing, you may find instant answers in our self-serve guides:</p>
      <div class="quick-links-group">
        <a href="/#faq" class="quick-link-btn">Browse Home FAQs →</a>
        <a href="/data-deletion" class="quick-link-btn">How to Erase Local Data →</a>
        <a href="/security#airplane-mode" class="quick-link-btn">Test Offline Functionality →</a>
        <a href="/privacy" class="quick-link-btn">Review Privacy & Data Safety →</a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .legal-page-container {
    padding-top: 3.5rem;
    padding-bottom: 5rem;
    max-width: 880px;
  }

  .legal-header {
    margin-bottom: 2.5rem;
  }

  .legal-title {
    margin-top: 1rem;
    margin-bottom: 0.5rem;
    font-size: clamp(2rem, 4vw, 3rem);
  }

  .legal-meta {
    font-size: 0.95rem;
    color: var(--on-surface-variant);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .contact-card {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
  }

  .card-icon {
    font-size: 2rem;
    margin-bottom: 0.75rem;
  }

  .contact-card h3 {
    font-size: 1.15rem;
    margin-bottom: 0.5rem;
  }

  .contact-card p {
    font-size: 0.9rem;
    line-height: 1.5;
    margin-bottom: 1.25rem;
    flex-grow: 1;
  }

  .contact-email-link {
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--primary);
    margin-bottom: 0.75rem;
    word-break: break-all;
  }

  .response-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--secondary);
    background-color: var(--secondary-container);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
    width: fit-content;
  }

  .self-serve-box {
    padding: 2rem;
    background-color: var(--surface-container-high);
    border: 1px solid var(--outline-variant);
  }

  .self-serve-box h3 {
    margin-bottom: 0.5rem;
  }

  .self-serve-box p {
    margin-bottom: 1.5rem;
  }

  .quick-links-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .quick-link-btn {
    background-color: var(--surface);
    color: var(--on-surface);
    border: 1px solid var(--outline-variant);
    padding: 0.6rem 1rem;
    border-radius: var(--radius-md);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .quick-link-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
    transform: translateY(-2px);
    text-decoration: none;
  }

  @media (max-width: 850px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
