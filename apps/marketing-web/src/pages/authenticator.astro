---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const playStoreUrl = "https://play.google.com/store/apps/details?id=com.idsnap.app&hl=en";

const pageTitle = "Offline 2FA Authenticator | Hardware Encrypted TOTP | IDSnap";
const pageDescription = "True offline two-factor authentication (TOTP RFC 6238). Protected by Android KeyStore hardware encryption, biometric lock, zero cloud sync, and no ads on the authenticator.";

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "IDSnap Offline 2FA Authenticator",
    "operatingSystem": "Android",
    "applicationCategory": "SecurityApplication",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "description": pageDescription,
    "url": "https://idsnap-bi3.pages.dev/authenticator",
    "downloadUrl": playStoreUrl,
    "featureList": [
      "Standard RFC 6238 TOTP 6-digit two-factor authentication",
      "Hardware-backed Android KeyStore / Secure Enclave encryption",
      "Biometric fingerprint / face unlock and device PIN protection",
      "FLAG_SECURE app switcher privacy prevents screenshot snooping",
      "Auto-clearing clipboard wipes 2FA codes after 30 seconds",
      "Encrypted local backup export without cloud account lock-in"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://idsnap-bi3.pages.dev"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Tools",
        "item": "https://idsnap-bi3.pages.dev/#core-tools"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Offline 2FA Authenticator",
        "item": "https://idsnap-bi3.pages.dev/authenticator"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Secure Your Accounts with an Offline 2FA Authenticator",
    "description": "Step-by-step instructions for adding and protecting 2FA TOTP accounts without relying on cloud sync.",
    "step": [
      {
        "@type": "HowToStep",
        "name": "Scan 2FA Setup QR Code",
        "text": "Open your online service (Google, GitHub, AWS, bank) and select Two-Factor Authentication. Scan the standard QR code with IDSnap camera scanner or manually enter the Base32 seed key."
      },
      {
        "@type": "HowToStep",
        "name": "Instant KeyStore Encryption",
        "text": "IDSnap seals the secret seed inside your smartphone's hardware-backed cryptographic KeyStore enclave (AES-256). The secret never leaves your physical device."
      },
      {
        "@type": "HowToStep",
        "name": "Copy Time-Based Codes with 1 Tap",
        "text": "Generate refreshed 6-digit codes every 30 seconds. Tap to copy, and IDSnap will automatically purge your clipboard after 30 seconds to block background clipboard snooping."
      },
      {
        "@type": "HowToStep",
        "name": "Export Encrypted Offline Backup",
        "text": "Create a password-protected local backup file before switching phones, keeping complete ownership of your security keys."
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Why is an offline 2FA authenticator safer than cloud-synced authenticators?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Cloud-synced authenticators store your two-factor seeds on remote company servers. If that cloud provider suffers a credential breach, SIM swap, or account takeover, your second factor of authentication is compromised simultaneously. IDSnap keeps secrets strictly bound to your local hardware enclave."
        }
      },
      {
        "@type": "Question",
        "name": "Does IDSnap require an account or phone number to use 2FA?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No. IDSnap requires no account, no email address, and no phone number. It launches immediately and works in 100% Airplane Mode with zero network permissions."
        }
      },
      {
        "@type": "Question",
        "name": "What happens if I change my phone?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "IDSnap includes a Data Independence export feature. You can export an encrypted, password-protected backup ZIP file to your SD card or external drive, and import it directly onto your new device."
        }
      },
      {
        "@type": "Question",
        "name": "What standards does the IDSnap authenticator support?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "IDSnap adheres strictly to RFC 6238 (TOTP: Time-Based One-Time Password Algorithm) with support for SHA-1, SHA-256, and SHA-512 hashes, making it compatible with Google, GitHub, Microsoft, AWS, Binance, Discord, and thousands of other services."
        }
      }
    ]
  }
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical="/authenticator"
  schema={schemaData}
>
  <!-- Hero Section -->
  <section class="tool-hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <Breadcrumbs items={[{ name: 'Tools', url: '/#core-tools' }, { name: '2FA Authenticator' }]} />
        <div class="badge-row">
          <span class="badge badge-primary">Zero Cloud Synced</span>
          <span class="badge badge-neutral">RFC 6238 TOTP Standard</span>
        </div>
        <h1 class="hero-title">
          Your 2FA seeds don't belong in the cloud. <span class="highlight">True hardware-encrypted authentication.</span>
        </h1>
        <p class="hero-lead">
          Cloud-based authenticators expose your critical security tokens to remote server leaks and SIM swaps. IDSnap keeps your two-factor credentials locked inside your device's physical hardware enclave—unreachable by internet attackers.
        </p>

        <div class="cta-actions">
          <a href={playStoreUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
              <path d="M3.609 1.814L13.793 12 3.61 22.186a2.235 2.235 0 0 1-.61-.318c-.469-.34-.75-.89-.75-1.488V3.62c0-.598.281-1.148.75-1.488.196-.142.408-.25.61-.318zm11.603 11.603l2.607-2.607-12.01-6.93 9.403 9.537zm0 1.166l-9.403 9.537 12.01-6.93-2.607-2.607zm1.166-1.166l3.208 1.852c.983.567.983 1.493 0 2.06l-3.208 1.852V13.417z"/>
            </svg>
            <span>Get on Google Play</span>
          </a>
          <a href="#security-layers" class="btn btn-secondary btn-lg">View Security Architecture</a>
        </div>

        <div class="trust-metrics">
          <div class="metric">
            <span class="metric-val">0 Packets</span>
            <span class="metric-label">Zero Network Traffic</span>
          </div>
          <div class="metric-divider"></div>
          <div class="metric">
            <span class="metric-val">KeyStore</span>
            <span class="metric-label">Hardware Enclave</span>
          </div>
          <div class="metric-divider"></div>
          <div class="metric">
            <span class="metric-val">30s Purge</span>
            <span class="metric-label">Clipboard Protection</span>
          </div>
        </div>
      </div>

      <div class="hero-preview">
        <div class="auth-vault-card">
          <div class="auth-header">
            <div class="auth-title-group">
              <span class="shield-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                </svg>
              </span>
              <div>
                <span class="auth-title">IDSnap Authenticator</span>
                <span class="auth-subtitle">Hardware Enclave Locked</span>
              </div>
            </div>
            <div class="time-ring">
              <svg viewBox="0 0 36 36" class="circular-chart">
                <path class="circle-bg" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"/>
                <path class="circle" stroke-dasharray="75, 100" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"/>
              </svg>
              <span class="ring-seconds">22s</span>
            </div>
          </div>

          <div class="totp-entries">
            <!-- Entry 1 -->
            <div class="totp-card">
              <div class="totp-meta">
                <div class="service-icon github">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/>
                  </svg>
                </div>
                <div class="service-details">
                  <span class="service-name">GitHub Production</span>
                  <span class="service-user">dev-lead@corp</span>
                </div>
              </div>
              <div class="totp-code-wrap">
                <span class="totp-code">849 201</span>
                <span class="copy-pill">Copied · auto-purge 28s</span>
              </div>
            </div>

            <!-- Entry 2 -->
            <div class="totp-card">
              <div class="totp-meta">
                <div class="service-icon aws">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"/>
                  </svg>
                </div>
                <div class="service-details">
                  <span class="service-name">AWS Root Account</span>
                  <span class="service-user">admin@infrastructure</span>
                </div>
              </div>
              <div class="totp-code-wrap">
                <span class="totp-code">315 994</span>
                <span class="tap-hint">Tap to copy</span>
              </div>
            </div>

            <!-- Entry 3 -->
            <div class="totp-card">
              <div class="totp-meta">
                <div class="service-icon bank">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="12 2 2 7 22 7"/>
                    <line x1="5" y1="21" x2="19" y2="21"/>
                    <line x1="5" y1="10" x2="5" y2="18"/>
                    <line x1="10" y1="10" x2="10" y2="18"/>
                    <line x1="14" y1="10" x2="14" y2="18"/>
                    <line x1="19" y1="10" x2="19" y2="18"/>
                  </svg>
                </div>
                <div class="service-details">
                  <span class="service-name">Primary Bank Portal</span>
                  <span class="service-user">client-id: 99410</span>
                </div>
              </div>
              <div class="totp-code-wrap">
                <span class="totp-code">602 447</span>
                <span class="tap-hint">Tap to copy</span>
              </div>
            </div>
          </div>

          <div class="auth-security-notice">
            <span class="lock-indicator">
              <svg class="icon-inline" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
              </svg>
              FLAG_SECURE: Screenshot & switcher blocking active
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Security Architecture -->
  <section id="security-layers" class="section bg-subtle">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-eyebrow">DEFENSE IN DEPTH</span>
        <h2 class="section-title">Built Against Real Threat Vectors</h2>
        <p class="section-subtitle">
          Standard authenticator apps ignore device-level attack vectors. IDSnap implements hardened safeguards at the OS and hardware boundaries.
        </p>
      </div>

      <div class="grid grid-3">
        <!-- Feature 1 -->
        <div class="card security-card">
          <div class="card-icon-wrap">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
          </div>
          <h3 class="card-title">Hardware KeyStore (AES-256)</h3>
          <p class="card-text">
            Secret seeds are encrypted using keys wrapped inside Android's KeyStore or Apple's Secure Enclave. Even if an attacker extracts a raw file backup, the cryptographic seeds remain undecryptable.
          </p>
        </div>

        <!-- Feature 2 -->
        <div class="card security-card">
          <div class="card-icon-wrap">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/>
              <line x1="1" y1="1" x2="23" y2="23"/>
            </svg>
          </div>
          <h3 class="card-title">Screen Privacy (FLAG_SECURE)</h3>
          <p class="card-text">
            Enforces native Android <code>FLAG_SECURE</code>. Screenshots are rejected by the operating system, and the app switcher replaces codes with a blank privacy shield so shoulder surfers see nothing.
          </p>
        </div>

        <!-- Feature 3 -->
        <div class="card security-card">
          <div class="card-icon-wrap">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/>
              <rect x="8" y="2" width="8" height="4" rx="1" ry="1"/>
            </svg>
          </div>
          <h3 class="card-title">Auto-Purging Clipboard</h3>
          <p class="card-text">
            Malicious background Android apps frequently monitor the system clipboard. When you copy a 2FA code in IDSnap, the app automatically purges the clipboard after 30 seconds.
          </p>
        </div>

        <!-- Feature 4 -->
        <div class="card security-card">
          <div class="card-icon-wrap">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 11c0 3.517-1.009 6.799-2.753 9.571m3.44-2.049A10.954 10.954 0 0 1 12 21c-2.396 0-4.606-.77-6.402-2.08m9.155-12.836A10.94 10.94 0 0 1 18 11c0 1.25-.21 2.45-.597 3.568M8.5 7.5a4 4 0 0 1 7 3.5c0 1.07-.423 2.05-1.12 2.774M10.5 15a2 2 0 0 1-2-2V9a3.5 3.5 0 0 1 7 0v2"/>
            </svg>
          </div>
          <h3 class="card-title">Biometric App Lock</h3>
          <p class="card-text">
            Require fingerprint, face biometric, or hardware device PIN on every cold launch or after configurable inactivity timeouts (immediate, 1 min, or 5 min).
          </p>
        </div>

        <!-- Feature 5 -->
        <div class="card security-card">
          <div class="card-icon-wrap">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.3c.4-.2.6-.6.5-1.1z"/>
            </svg>
          </div>
          <h3 class="card-title">Seeds Never Leave the Phone</h3>
          <p class="card-text">
            Your 2FA seeds stay in the Android KeyStore and IDSnap's own code makes no network calls. The only internet use is Google's ad SDK on a few other screens; it never appears on the authenticator and never sees your seeds or codes.
          </p>
        </div>

        <!-- Feature 6 -->
        <div class="card security-card">
          <div class="card-icon-wrap">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
              <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
              <line x1="12" y1="22.08" x2="12" y2="12"/>
            </svg>
          </div>
          <h3 class="card-title">Data Independence Export</h3>
          <p class="card-text">
            No cloud vendor lock-in. Back up your tokens to an AES-256 password-encrypted ZIP archive that you control and can restore on any new phone.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Comparison Matrix -->
  <section class="section">
    <div class="container max-w-reading">
      <div class="section-header text-center">
        <span class="section-eyebrow">HEAD-TO-HEAD</span>
        <h2 class="section-title">IDSnap vs Traditional Authenticator Apps</h2>
      </div>

      <div class="comparison-table-wrap">
        <table class="comparison-table">
          <thead>
            <tr>
              <th>Security Vector</th>
              <th>Big Tech Cloud 2FA</th>
              <th>IDSnap Offline Vault</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Account Requirement</strong></td>
              <td class="negative">Mandatory Google / MS Login</td>
              <td class="positive">Zero Account Required</td>
            </tr>
            <tr>
              <td><strong>Cloud Seed Storage</strong></td>
              <td class="negative">Stored on remote servers</td>
              <td class="positive">100% On-Device Only</td>
            </tr>
            <tr>
              <td><strong>Clipboard Safety</strong></td>
              <td class="negative">Codes remain in clipboard forever</td>
              <td class="positive">Auto-purges after 30 seconds</td>
            </tr>
            <tr>
              <td><strong>Screen / Switcher Blocking</strong></td>
              <td class="neutral">Optional / Disabled by default</td>
              <td class="positive">Enforced with FLAG_SECURE</td>
            </tr>
            <tr>
              <td><strong>Internet Permission in OS</strong></td>
              <td class="negative">Full Internet Access Required</td>
              <td class="positive">Zero Network Permission</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="section bg-subtle">
    <div class="container max-w-reading">
      <div class="section-header text-center">
        <span class="section-eyebrow">QUESTIONS & ANSWERS</span>
        <h2 class="section-title">Frequently Asked Questions</h2>
      </div>

      <div class="faq-accordion">
        <div class="faq-item">
          <h3 class="faq-question">What if I drop my phone or lose it?</h3>
          <div class="faq-answer">
            <p>
              Because IDSnap does not sync to a central server, you should periodically make a local encrypted backup. Go to Settings › Export Backup, set a strong passphrase, and save the resulting ZIP file to a secure offline USB drive, computer, or personal storage.
            </p>
          </div>
        </div>

        <div class="faq-item">
          <h3 class="faq-question">Is IDSnap compatible with Google, GitHub, and Amazon?</h3>
          <div class="faq-answer">
            <p>
              Yes. IDSnap implements RFC 6238, the universal industry standard for Time-based One-Time Passwords (TOTP). Any service that displays a QR code for 2FA setup works with IDSnap.
            </p>
          </div>
        </div>

        <div class="faq-item">
          <h3 class="faq-question">Can I use both IDSnap's Document Scanner and Authenticator together?</h3>
          <div class="faq-answer">
            <p>
              Yes! IDSnap is a unified, calm offline identity studio. You can securely store your digitized passport, ID cards, tax certificates, and two-factor tokens in one encrypted, offline app.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="section bg-primary text-white text-center">
    <div class="container max-w-reading">
      <h2 class="cta-title">Upgrade to zero-cloud 2FA security today</h2>
      <p class="cta-lead">
        Protect your accounts with hardware-enclave encryption. Completely free, no account, and never an ad on your codes.
      </p>
      <div class="cta-btn-wrap">
        <a href={playStoreUrl} target="_blank" rel="noopener noreferrer" class="btn btn-light btn-lg">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
            <path d="M3.609 1.814L13.793 12 3.61 22.186a2.235 2.235 0 0 1-.61-.318c-.469-.34-.75-.89-.75-1.488V3.62c0-.598.281-1.148.75-1.488.196-.142.408-.25.61-.318zm11.603 11.603l2.607-2.607-12.01-6.93 9.403 9.537zm0 1.166l-9.403 9.537 12.01-6.93-2.607-2.607zm1.166-1.166l3.208 1.852c.983.567.983 1.493 0 2.06l-3.208 1.852V13.417z"/>
          </svg>
          <span>Download Free on Google Play</span>
        </a>
      </div>
      <p class="cta-subtext">Open standards · 100% on-device · Private by design</p>
    </div>
  </section>
</Layout>

<style>
  .tool-hero {
    padding: 4rem 0 3rem;
    background: linear-gradient(180deg, var(--surface-subtle) 0%, var(--surface) 100%);
    border-bottom: 1px solid var(--border-subtle);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 3.5rem;
    align-items: center;
  }
  .badge-row {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }
  .hero-title {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    line-height: 1.2;
    margin-bottom: 1.25rem;
    font-weight: 800;
  }
  .hero-lead {
    font-size: 1.125rem;
    color: var(--on-surface-muted);
    line-height: 1.6;
    margin-bottom: 2rem;
  }
  .cta-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
  }
  .trust-metrics {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-subtle);
