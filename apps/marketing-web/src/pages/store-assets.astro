---
import Layout from '../layouts/Layout.astro';

const assets = [
  {
    type: "App Icon",
    specs: "PNG • 512 × 512 px • Max 1 MB",
    filename: "app_icon_512x512.png",
    path: "/store-assets/app_icon_512x512.png",
    description: "Official Google Play store listing icon. Features the crisp white background canvas with royal blue (#2457D6) viewfinder scan brackets and bold IDSnap identity monogram."
  },
  {
    type: "Feature Graphic",
    specs: "PNG • 1024 × 500 px • Max 15 MB",
    filename: "feature_graphic_1024x500.png",
    path: "/store-assets/feature_graphic_1024x500.png",
    description: "Featured showcase banner for Google Play store home page, promotional collections, and search highlights."
  },
  {
    type: "Phone Screenshot 1 (Home Dashboard)",
    specs: "PNG • 1080 × 2400 px (9:16)",
    filename: "phone_screenshot_1_home.png",
    path: "/store-assets/phone_screenshot_1_home.png",
    description: "Authentic Android screenshot of the IDSnap home dashboard, quick tool shortcuts, and on-device indicators."
  },
  {
    type: "Phone Screenshot 2 (Everyday Tools Suite)",
    specs: "PNG • 1080 × 2400 px (9:16)",
    filename: "phone_screenshot_2_tools.png",
    path: "/store-assets/phone_screenshot_2_tools.png",
    description: "Authentic Android screenshot showing the complete utility suite: ID Card 2-in-1, PDF compressor under 200KB, and passport photo studio."
  },
  {
    type: "Phone Screenshot 3 (Offline Vault & Storage)",
    specs: "PNG • 1080 × 2400 px (9:16)",
    filename: "phone_screenshot_3_files.png",
    path: "/store-assets/phone_screenshot_3_files.png",
    description: "Authentic Android screenshot demonstrating on-device private document storage."
  },
  {
    type: "Phone Screenshot 4 (Privacy & Scanning Preferences)",
    specs: "PNG • 1080 × 2400 px (9:16)",
    filename: "phone_screenshot_4_settings.png",
    path: "/store-assets/phone_screenshot_4_settings.png",
    description: "Authentic Android screenshot demonstrating theme modes, on-device OCR engines, automatic edge detection, and offline security preferences."
  }
];
---

<Layout
  title="Google Play Visual Assets & Media Kit"
  description="Download official, specification-compliant App Icon (512x512), Feature Graphic (1024x500), and 1080px Phone Screenshots for IDSnap."
>
  <div class="container legal-page-container">
    <div class="legal-header">
      <div class="badge-pill">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
          <circle cx="8.5" cy="8.5" r="1.5"></circle>
          <polyline points="21 15 16 10 5 21"></polyline>
        </svg>
        Ready for Google Play Console Upload
      </div>
      <h1 class="legal-title">Google Play Store Visual Assets</h1>
      <p class="legal-meta">Pre-formatted and validated against Google Play Developer Console content guidelines.</p>
    </div>

    <!-- Quick instructions -->
    <div class="card-glass summary-box">
      <h3>Ready-to-Upload Specifications</h3>
      <p>
        These assets strictly follow Google Play's <strong>512 × 512 px App Icon</strong>, <strong>1024 × 500 px Feature Graphic</strong>, and <strong>minimum 1080 px Phone Screenshots</strong> (9:16 aspect ratio) requirements to ensure full promotion eligibility.
      </p>
    </div>

    <div class="assets-grid">
      {assets.map((asset) => (
        <div class="card-glass asset-card">
          <div class="asset-preview-box">
            <img src={asset.path} alt={asset.type} class="asset-img" loading="lazy" />
          </div>
          <div class="asset-info">
            <span class="badge-pill badge-primary">{asset.specs}</span>
            <h3 class="asset-name">{asset.type}</h3>
            <p class="asset-desc">{asset.description}</p>
            <a href={asset.path} download={asset.filename} class="btn btn-secondary download-btn">
              Download {asset.filename}
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</Layout>

<style>
  .legal-page-container {
    padding-top: 3.5rem;
    padding-bottom: 5rem;
    max-width: 960px;
  }

  .legal-header {
    margin-bottom: 2rem;
  }

  .legal-title {
    margin-top: 0.85rem;
    margin-bottom: 0.5rem;
    font-size: clamp(2rem, 4vw, 3rem);
  }

  .legal-meta {
    font-size: 0.95rem;
    color: var(--on-surface-variant);
  }

  .summary-box {
    margin-bottom: 3rem;
    background-color: var(--surface-container-high);
    border: 1px solid var(--outline-variant);
  }

  .assets-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  .asset-card {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 2rem;
    align-items: center;
    padding: 1.75rem;
  }

  .asset-preview-box {
    background-color: var(--canvas);
    border: 1px solid var(--outline-variant);
    border-radius: var(--radius-md);
    padding: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    max-height: 380px;
    overflow: hidden;
  }

  .asset-img {
    max-width: 100%;
    max-height: 340px;
    object-fit: contain;
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-md);
  }

  .asset-info {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .asset-name {
    font-size: 1.35rem;
  }

  .asset-desc {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--on-surface-variant);
  }

  .download-btn {
    align-self: flex-start;
    margin-top: 0.5rem;
  }

  @media (max-width: 768px) {
    .asset-card {
      grid-template-columns: 1fr;
    }
    .asset-preview-box {
      max-height: 280px;
    }
  }
</style>
