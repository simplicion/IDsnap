---
import Layout from '../layouts/Layout.astro';

const privacySchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "IDSnap Privacy Policy & Data Safety",
  "description": "Official Privacy Policy for IDSnap. Explains our on-device architecture and compliance with Google Play Data Safety and Apple App Privacy guidelines.",
  "publisher": {
    "@type": "Organization",
    "name": "IDSnap",
    "url": "https://idsnap.app"
  }
};
---

<Layout
  title="Privacy Policy & Google Play Data Safety"
  description="IDSnap never uploads your documents and does not track you. Read our Privacy Policy and Google Play Data Safety specifications."
  schema={privacySchema}
>
  <div class="container legal-page-container">
    <div class="legal-header">
      <div class="badge-pill">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        </svg>
        Your Documents Never Leave Your Phone
      </div>
      <h1 class="legal-title">Privacy Policy & Data Safety</h1>
      <p class="legal-meta">Last Updated & Verified: September 25, 2026 • Effective Immediately</p>
    </div>

    <!-- Quick Summary Box -->
    <div class="card-glass summary-box">
      <h3>The IDSnap Privacy Promise in Plain English</h3>
      <p>
        <strong>IDSnap is an accountless, on-device application.</strong> We do not operate document servers or cloud processing pipelines. Every scan, ID card collage, 2FA authenticator seed, and OCR extraction runs <strong>exclusively on your device</strong>. IDSnap Pro licences are checked by our licence server, which stores only an anonymous device id, your plan and its purchase record — never documents, photos, 2FA secrets or OCR text. We do not sell, rent, monetize, or track your personal information.
      </p>
      <div class="promise-badges">
        <span class="promise-tag">✓ No Document Uploads</span>
        <span class="promise-tag">✓ No Account or Login Required</span>
        <span class="promise-tag">✓ No Third-Party Analytics SDKs</span>
        <span class="promise-tag">✓ No Advertising Trackers</span>
        <span class="promise-tag">✓ Tools Work Offline</span>
      </div>
    </div>

    <div class="legal-body">
      <section id="google-play" class="legal-section">
        <h2>1. Google Play Store Data Safety Declarations</h2>
        <p>
          For the purposes of the Google Play Console Data Safety questionnaire, IDSnap declares the following:
        </p>
        <div class="table-wrap">
          <table class="compliance-table">
            <thead>
              <tr>
                <th>Data Category</th>
                <th>Collected?</th>
                <th>Shared?</th>
                <th>Processing Type</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Personal IDs & Documents</strong> (Passports, Driver's Licenses, Cards)</td>
                <td><span class="badge-pill badge-primary">No</span></td>
                <td><span class="badge-pill badge-primary">No</span></td>
                <td>Ephemeral local-only processing in on-device SQLite database.</td>
              </tr>
              <tr>
                <td><strong>2FA Secrets & TOTP Seeds</strong></td>
                <td><span class="badge-pill badge-primary">No</span></td>
                <td><span class="badge-pill badge-primary">No</span></td>
                <td>Encrypted in Android KeyStore via <code>flutter_secure_storage</code>.</td>
              </tr>
              <tr>
                <td><strong>Photos & Camera Video Stream</strong></td>
                <td><span class="badge-pill badge-primary">No</span></td>
                <td><span class="badge-pill badge-primary">No</span></td>
                <td>Direct viewfinder feed; never transmitted over network.</td>
              </tr>
              <tr>
                <td><strong>Biometric Data</strong> (Fingerprint / Face ID)</td>
                <td><span class="badge-pill badge-primary">No</span></td>
                <td><span class="badge-pill badge-primary">No</span></td>
                <td>Evaluated entirely by OS hardware enclave; app receives only binary pass/fail token.</td>
              </tr>
              <tr>
                <td><strong>Device Identifiers & Telemetry</strong></td>
                <td>Licence only</td>
                <td><span class="badge-pill badge-primary">No</span></td>
                <td>An anonymous device id, platform and app version are sent to the IDSnap licence server to activate and check Pro. No analytics or crash reporting SDKs are installed.</td>
              </tr>
              <tr>
                <td><strong>Purchase History</strong></td>
                <td>Yes (Pro only)</td>
                <td>Payment processor</td>
                <td>Payments are handled by our payment provider in your browser; the licence server keeps the plan and purchase record needed to unlock Pro.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <section id="apple-privacy" class="legal-section">
        <h2>2. Apple App Store Privacy Nutrition Labels</h2>
        <p>
          In accordance with Apple's App Privacy requirements for the iOS App Store:
        </p>
        <ul>
          <li><strong>Data Used to Track You:</strong> None. IDSnap does not track users across apps and websites owned by other companies.</li>
          <li><strong>Data Linked to You:</strong> None. No data collected is tied to your identity.</li>
          <li><strong>Data Not Linked to You:</strong> None. IDSnap does not collect diagnostics or usage metrics.</li>
        </ul>
      </section>

      <section id="permissions" class="legal-section">
        <h2>3. Device Permissions & How They Are Used</h2>
        <p>
          IDSnap requests only the minimum device permissions strictly required to perform local utility operations:
        </p>
        <div class="permissions-grid">
          <div class="permission-item">
            <h4><svg class="icon-inline" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path><circle cx="12" cy="13" r="4"></circle></svg> Camera (<code>android.permission.CAMERA</code> / <code>NSCameraUsageDescription</code>)</h4>
            <p>Required to operate the document scanner, detect ID card borders, and scan 2FA setup QR codes. Captured frames stay in temporary device memory until processed.</p>
          </div>
          <div class="permission-item">
            <h4><svg class="icon-inline" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg> Storage / Photos (Scoped Photo Picker)</h4>
            <p>Used solely when you explicitly tap "Import photo" or "Import PDF" to select an image from your gallery, and when you tap "Save to device" to export the generated file to your local Downloads or Documents folder.</p>
          </div>
          <div class="permission-item">
            <h4><svg class="icon-inline" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><circle cx="12" cy="11" r="2"></circle><path d="M12 13v3"></path></svg> Biometrics (<code>USE_BIOMETRIC</code> / <code>NSFaceIDUsageDescription</code>)</h4>
            <p>Allows you to unlock your local ID Vault and reveal 2FA codes using your fingerprint or Face ID. Your biometric templates never leave the secure hardware enclave of your phone.</p>
          </div>
        </div>
      </section>

      <section id="gdpr" class="legal-section">
        <h2>4. GDPR & CCPA/CPRA Compliance (Your Data Rights)</h2>
        <p>
          Because IDSnap stores your documents only on your device and has no user accounts:
        </p>
        <ul>
          <li><strong>Right of Access & Portability (GDPR Art. 15/20):</strong> You have direct, unhindered access to all your files at all times through the in-app "Files" tab and the "Share / Save to Device" buttons.</li>
          <li><strong>Right to Erasure / "To Be Forgotten" (GDPR Art. 17):</strong> You can delete any individual document, 2FA account, or your entire database directly from the app settings, or by simply clearing the app data / uninstalling the app. No copies of your documents exist on our servers. To remove your licence record, contact us.</li>
          <li><strong>Do Not Sell My Personal Information (CCPA):</strong> We have never sold, rented, or shared personal information with third parties, and your documents never reach us in the first place.</li>
        </ul>
      </section>

      <section id="children" class="legal-section">
        <h2>5. Children's Privacy (COPPA Compliance)</h2>
        <p>
          IDSnap does not knowingly collect or solicit personal information from children under the age of 13. Since documents are never transmitted off the device, IDSnap is safe for use by students of all ages.
        </p>
      </section>

      <section id="security-measures" class="legal-section">
        <h2>6. Security of Your Local Data</h2>
        <p>
          Documents saved in IDSnap reside inside the app-private sandbox directory managed by the Android and iOS operating systems. Other third-party apps on your phone cannot read these files without root access or explicit OS file-sharing permissions granted by you.
        </p>
      </section>

      <section id="contact-privacy" class="legal-section">
        <h2>7. Contact & Verification Inquiries</h2>
        <p>
          If you have questions regarding this Privacy Policy or wish to conduct a technical security audit, contact our compliance team:
        </p>
        <div class="contact-box">
          <p><strong>Privacy & Security Team:</strong> <a href="mailto:privacy@idsnap.app">privacy@idsnap.app</a></p>
          <p><strong>Developer Support:</strong> <a href="/contact">Visit Support Center</a></p>
          <p><strong>Security Architecture Guide:</strong> <a href="/security">Read Technical Verification</a></p>
        </div>
      </section>
    </div>
  </div>
</Layout>

<style>
  .legal-page-container {
    padding-top: 3.5rem;
    padding-bottom: 5rem;
    max-width: 840px;
  }

  .legal-header {
    margin-bottom: 2.5rem;
  }

  .legal-title {
    margin-top: 1rem;
    margin-bottom: 0.5rem;
    font-size: clamp(2rem, 4vw, 3rem);
  }

  .legal-meta {
    font-size: 0.95rem;
    color: var(--on-surface-variant);
  }

  .summary-box {
    margin-bottom: 3.5rem;
    background-color: var(--primary-container);
    border: 1px solid rgba(36, 87, 214, 0.2);
  }

  .summary-box h3 {
    color: var(--on-primary-container);
    margin-bottom: 0.75rem;
  }

  .summary-box p {
    color: var(--on-primary-container);
    font-size: 1.05rem;
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .promise-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .promise-tag {
    background-color: var(--surface);
    color: var(--primary);
    font-size: 0.85rem;
    font-weight: 700;
    padding: 0.35rem 0.8rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--outline-variant);
  }

  .legal-body {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .legal-section h2 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
    color: var(--on-surface);
    border-bottom: 2px solid var(--outline-variant);
    padding-bottom: 0.5rem;
  }

  .legal-section p {
    margin-bottom: 1rem;
  }

  .legal-section ul {
    list-style-type: disc;
    padding-left: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    color: var(--on-surface-variant);
    font-size: 1rem;
    line-height: 1.6;
  }

  .table-wrap {
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  .compliance-table {
    width: 100%;
    border-collapse: collapse;
    background-color: var(--surface);
    border: 1px solid var(--outline-variant);
    border-radius: var(--radius-md);
  }

  .compliance-table th, .compliance-table td {
    padding: 1rem;
    text-align: left;
    border-bottom: 1px solid var(--outline-variant);
    font-size: 0.95rem;
  }

  .compliance-table th {
    background-color: var(--surface-container-high);
    font-weight: 700;
    color: var(--on-surface);
  }

  .permissions-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin-top: 1.25rem;
  }

  .permission-item {
    background-color: var(--surface);
    border: 1px solid var(--outline-variant);
    border-radius: var(--radius-md);
    padding: 1.25rem;
  }

  .permission-item h4 {
    margin-bottom: 0.4rem;
    color: var(--on-surface);
  }

  .contact-box {
    background-color: var(--surface-container);
    border: 1px solid var(--outline-variant);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 1rem;
  }
</style>
