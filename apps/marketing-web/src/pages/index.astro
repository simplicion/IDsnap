---
import Layout from '../layouts/Layout.astro';

// Structured FAQ Data for SEO Schema (Google SERP rich snippets)
const faqItems = [
  {
    question: "Do my documents ever leave my phone?",
    answer: "No. Your documents never leave your phone. Scanning, perspective correction, OCR, PDF tools, image compression and 2FA code generation all run on the device, and they keep working in Airplane Mode. IDSnap goes online only to activate and check your Pro licence (it sends an anonymous device id, never documents) and, on Android, to download Google's document-scanner module once."
  },
  {
    question: "How does the 'ID Card Front & Back on 1 Page' feature work?",
    answer: "IDSnap provides a specialized 2-step capture guide. You snap the front of your ID card, flip it to snap the back, and our engine automatically deskews both images and arranges them centered on a clean white A4 or Letter PDF sheet, ready to submit for bank KYC, application portals, or job applications."
  },
  {
    question: "How does the built-in 2FA Authenticator protect my login codes?",
    answer: "IDSnap implements the industry-standard RFC 6238 TOTP algorithm. Secret keys are encrypted with a key held by Android KeyStore or the Apple Keychain (hardware-backed on phones that support it). Access can be guarded with your biometric fingerprint or Face ID."
  },
  {
    question: "Can I compress a PDF or photo to an exact file size like 'under 200 KB'?",
    answer: "Yes. Instead of making you guess quality percentages, IDSnap features an intelligent target-size search engine. You specify your target (e.g. 200 KB for government exam portals), and IDSnap searches for the dimensions and compression that keep the output under your target while keeping it as legible as possible."
  },
  {
    question: "What happens if I lose my phone? Does IDSnap have cloud backup?",
    answer: "By design, IDSnap has no user accounts and no cloud storage for your documents, so there is nothing to restore from a server. Use Settings › Export all data to save a backup to a place of your choice (your computer, a USB drive or your own cloud folder). Optional password-protected backups (AES-256) keep that file private; keep the password safe, because nobody can recover it for you."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<Layout
  title="IDSnap — Your Identity & Everyday Document Vault | Private & On-Device"
  description="IDSnap is the all-in-one private identity & document studio. Scan ID cards front-and-back on 1 page, generate offline 2FA authenticator codes, crop passport photos, and compress PDFs under 200 KB."
  schema={faqSchema}
>
  <!-- =========================================================================
       HERO SECTION
       ========================================================================= -->
  <section class="section hero-section">
    <div class="container hero-container">
      <div class="hero-content">
