---
import Layout from '../layouts/Layout.astro';

const playStoreUrl = "https://play.google.com/store/apps/details?id=com.idsnap.app&hl=en";

// Structured FAQ Data for SEO Schema (Google SERP rich snippets)
const faqItems = [
  {
    question: "Do my documents ever leave my phone?",
    answer: "No. Your documents never leave your phone. Scanning, edge straightening, OCR, PDF tools, image compression, and 2FA code generation all execute locally in device memory, and they work fully in Airplane Mode. In fact, IDSnap's production release manifest requests zero internet permissions."
  },
  {
    question: "How does the 'ID Card Front & Back on 1 Page' scanner work?",
    answer: "IDSnap provides a specialized 2-step capture guide. You snap the front of your ID card, flip it to snap the back, and our engine automatically straightens both sides to standard ISO/IEC 7810 ID-1 card dimensions and arranges them centered on a clean white A4 or Letter sheet, ready for banking KYC or job submissions."
  },
  {
    question: "Can I make official passport and visa photos?",
    answer: "Yes. IDSnap includes biometric framing guides for standard international passport sizes: 35×45 mm (Schengen, UK, India, Canada), 2×2 inches (US Visa DS-160, Green Card, passport), 33×48 mm, and stamp sizes, plus 4×6 inch multi-copy print sheets."
  },
  {
    question: "How do application kits help with UPSC, SSC, and university forms?",
    answer: "Government exam portals and university systems enforce strict upload limits (e.g., photo strictly under 50 KB, signature strictly under 20 KB, and certificate PDF under 200 KB). IDSnap's built-in application kits automatically apply these constraints in one guided flow."
  },
  {
    question: "How does the built-in 2FA Authenticator protect my login codes?",
    answer: "IDSnap implements the industry-standard RFC 6238 TOTP algorithm. Secret seeds are encrypted using hardware-backed Android KeyStore / Secure Enclave (AES-256). Codes are protected with biometric unlock, FLAG_SECURE screen privacy, and an auto-purging clipboard that wipes copied tokens after 30 seconds."
  },
  {
    question: "Can I compress a PDF to an exact target file size like 'under 200 KB'?",
    answer: "Yes. Instead of making you guess vague percentage sliders, IDSnap uses an intelligent binary-search compressor. You specify your exact target (e.g. 200 KB, 100 KB, or 50 KB), and IDSnap calculates the optimal DPI and compression to keep text crisp while strictly staying below your portal's limit."
  },
  {
    question: "What happens if I lose my phone? Does IDSnap have cloud backup?",
    answer: "By design, IDSnap stores no files on cloud servers. We believe in true Data Independence: you can export a password-protected, encrypted ZIP backup (AES-256) of your entire vault and restore it on any new device without vendor lock-in."
  }
];

const homeSchema = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "IDSnap: Identity & Document Studio",
    "operatingSystem": "Android",
    "applicationCategory": "BusinessApplication",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "description": "The private identity and document studio for your phone. Scan ID cards front-and-back, auto-frame passport photos, compress PDFs to target sizes, and protect 2FA keys 100% offline.",
    "url": "https://idsnap.app/",
    "downloadUrl": playStoreUrl,
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.9",
      "ratingCount": "1280"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqItems.map(item => ({
      "@type": "Question",
      "name": item.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": item.answer
      }
    }))
  }
];
---

<Layout
  title="IDSnap — The Private Identity & Document Studio | 100% Offline"
  description="IDSnap is the all-in-one private identity & document studio for your phone. Merge ID cards front-and-back on 1 page, crop official passport photos, compress PDFs under 200 KB, and safeguard 2FA keys with zero cloud uploads."
  canonical="https://idsnap.app/"
  schema={homeSchema}
>
  <!-- =========================================================================
       HERO SECTION
       ========================================================================= -->
  <section class="section hero-section">
    <div class="container hero-container">
      <div class="hero-content">
        <div class="badge-pill hero-badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
          100% Offline • Zero Account • Hardware Enclave Encrypted
        </div>

        <h1 class="hero-headline">
          The Private Identity & <span class="gradient-text">Document Studio.</span>
        </h1>

        <p class="hero-subhead">
          Scan ID cards front-and-back on 1 page, auto-frame official passport photos, compress PDFs to exact portal limits (under 200 KB), and safeguard 2FA keys—with no accounts, no ads, and zero server uploads.
        </p>

        <div class="hero-cta-group" id="download">
          <a href={playStoreUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-hero">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
              <path d="M3.609 1.814L13.793 12 3.61 22.186a2.235 2.235 0 0 1-.61-.318c-.469-.34-.75-.89-.75-1.488V3.62c0-.598.281-1.148.75-1.488.196-.142.408-.25.61-.318zm11.603 11.603l2.607-2.607-12.01-6.93 9.403 9.537zm0 1.166l-9.403 9.537 12.01-6.93-2.607-2.607zm1.166-1.166l3.208 1.852c.983.567.983 1.493 0 2.06l-3.208 1.852V13.417z"/>
            </svg>
            <span>Get on Google Play</span>
          </a>

          <a href="#core-tools" class="btn btn-secondary btn-hero">
            Explore All 7 Tools
          </a>
        </div>

        <div class="hero-trust-indicators">
          <div class="trust-item">
            <span class="trust-icon">✓</span>
            <span>Zero Network Permissions</span>
          </div>
          <div class="trust-item">
            <span class="trust-icon">✓</span>
            <span>Airplane-Mode Tested</span>
          </div>
          <div class="trust-item">
            <span class="trust-icon">✓</span>
            <span>Zero Ads & Tracking</span>
          </div>
        </div>
      </div>

      <!-- Hero Phone UI Mockup Showcase -->
      <div class="hero-mockup-wrapper">
        <div class="phone-mockup">
          <div class="phone-notch"></div>
          <div class="phone-screen">
            <!-- App Bar Mockup -->
            <div class="app-mock-header">
              <div class="mock-brand">
                <span class="mock-dot"></span>
                <strong>IDSnap</strong>
              </div>
              <span class="mock-pill">Offline Vault</span>
            </div>

            <!-- Identity Card Showcase Widget -->
            <div class="mock-card id-card-preview">
              <div class="mock-card-header">
                <span class="mock-tag">🪪 ID Card Merger</span>
                <span class="mock-status">1 A4 Page Ready</span>
              </div>
              <div class="mock-id-sheets">
                <div class="mock-id-face front">
                  <div class="mock-avatar"></div>
                  <div class="mock-lines">
                    <div class="line l1"></div>
                    <div class="line l2"></div>
                  </div>
                  <span class="face-label">FRONT</span>
                </div>
                <div class="mock-id-face back">
                  <div class="mock-barcode"></div>
                  <span class="face-label">BACK</span>
                </div>
              </div>
            </div>

            <!-- Passport Photo Guide Widget -->
            <div class="mock-card passport-preview">
              <div class="mock-card-header">
                <span class="mock-tag">📸 Photo Studio</span>
                <span class="mock-badge-success">US Visa 2×2 in</span>
              </div>
              <div class="passport-mini-guide">
                <div class="oval-head-guide">
                  <span class="guide-tag">Biometric Guide: 50–69%</span>
                </div>
                <div class="passport-specs">
                  <span class="spec-dim">600×600 px · ≤ 240 KB</span>
                  <span class="spec-verified">● White Background OK</span>
                </div>
              </div>
            </div>

            <!-- 2FA Authenticator Showcase Widget -->
            <div class="mock-card totp-preview">
              <div class="mock-card-header">
                <span class="mock-tag">🔐 Offline 2FA</span>
                <div class="mock-timer-circle">
                  <span class="timer-sec">28s</span>
                </div>
              </div>
              <div class="totp-row">
                <div class="totp-info">
                  <span class="totp-account">GitHub Enterprise</span>
                  <span class="totp-user">dev-lead@corp</span>
                </div>
                <div class="totp-code">
                  <code>584 920</code>
                </div>
              </div>
            </div>

            <!-- Everyday Tool Widget -->
            <div class="mock-card tool-preview">
              <div class="mock-card-header">
                <span class="mock-tag">⚡ Target Compressor</span>
                <span class="mock-badge-success">Saved 95%</span>
              </div>
              <div class="compress-stats">
                <span class="stat-old">4.2 MB</span>
                <span class="stat-arrow">→</span>
                <span class="stat-new">184 KB</span>
                <span class="stat-portal">(Portal Ready)</span>
              </div>
            </div>

            <!-- Bottom Mock Nav -->
            <div class="mock-bottom-nav">
              <div class="nav-item active">Vault</div>
              <div class="nav-item">Scanner</div>
              <div class="nav-item">2FA</div>
              <div class="nav-item">Tools</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       CORE TOOLS & LANDING PAGES SHOWCASE (7 ESSENTIAL SUITES)
       ========================================================================= -->
  <section id="core-tools" class="section bg-subtle">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-eyebrow">THE COMPLETE STUDIO</span>
        <h2 class="section-title">Seven Purpose-Built Tools in One Quiet App</h2>
        <p class="section-subtitle">
          Instead of downloading seven different adware-filled utilities, IDSnap combines all essential everyday document and identity tasks into a unified, local-first studio.
        </p>
      </div>

      <div class="tools-grid-7">
        <!-- Tool 1: ID Card Scanner -->
        <a href="/id-card-scanner" class="card tool-feature-card">
          <div class="tool-icon">🪪</div>
          <div class="tool-body">
            <div class="tool-badge">IDENTITY SUITE</div>
            <h3 class="tool-title">ID Card 1-Sheet Scanner</h3>
            <p class="tool-desc">
              Snap the front and back of your driving license, national ID, or insurance card. IDSnap deskews both sides to ISO ID-1 actual size and aligns them on one A4 sheet with an optional purpose watermark.
            </p>
            <span class="tool-link-text">Learn about ID card merging →</span>
          </div>
        </a>

        <!-- Tool 2: Passport Photo Studio -->
        <a href="/passport-photo-maker" class="card tool-feature-card">
          <div class="tool-icon">📸</div>
          <div class="tool-body">
            <div class="tool-badge">BIOMETRIC SUITE</div>
            <h3 class="tool-title">Passport & Visa Photo Studio</h3>
            <p class="tool-desc">
              Auto-crop portraits with biometric face guides. Supports 35×45 mm (Schengen, UK, India), 2×2 in (US Visa & Green Card), stamp sizes, and multi-copy 4×6 inch print sheet layouts.
            </p>
            <span class="tool-link-text">Explore passport photo presets →</span>
          </div>
        </a>

        <!-- Tool 3: Target-Size PDF Compressor -->
        <a href="/compress-pdf" class="card tool-feature-card">
          <div class="tool-icon">⚡</div>
          <div class="tool-body">
            <div class="tool-badge">COMPRESSION SUITE</div>
            <h3 class="tool-title">Target-Size PDF Compressor</h3>
            <p class="tool-desc">
              End the guesswork. Type your exact portal limit (e.g., "under 200 KB", "under 100 KB", or "under 50 KB"). Our binary-search compression engine hits your target while preserving sharp text legibility.
            </p>
            <span class="tool-link-text">Try target compressor details →</span>
          </div>
        </a>

        <!-- Tool 4: Exam & Job Application Kits -->
        <a href="/exam-application-kits" class="card tool-feature-card">
          <div class="tool-icon">📋</div>
          <div class="tool-body">
            <div class="tool-badge">APPLICATION SUITE</div>
            <h3 class="tool-title">Exam & Application Kits</h3>
            <p class="tool-desc">
              Pre-configured bundles for UPSC, SSC, US Visa, and college admissions. Prepares candidate photos (≤ 50 KB), cleans handwritten ink signatures (≤ 20 KB), and compresses certificates (≤ 200 KB) in one flow.
            </p>
            <span class="tool-link-text">View pre-configured portal kits →</span>
          </div>
        </a>

        <!-- Tool 5: Offline 2FA Authenticator -->
        <a href="/authenticator" class="card tool-feature-card">
          <div class="tool-icon">🔐</div>
          <div class="tool-body">
            <div class="tool-badge">SECURITY SUITE</div>
            <h3 class="tool-title">Offline 2FA Authenticator</h3>
            <p class="tool-desc">
              RFC 6238 TOTP authenticator with hardware-backed Android KeyStore encryption (AES-256). Features biometric lock, screenshot blocking (FLAG_SECURE), and a 30-second clipboard auto-purge.
            </p>
            <span class="tool-link-text">See 2FA security architecture →</span>
          </div>
        </a>

        <!-- Tool 6: Encrypted Document Vault -->
        <a href="/document-vault" class="card tool-feature-card">
          <div class="tool-icon">📁</div>
          <div class="tool-body">
            <div class="tool-badge">VAULT SUITE</div>
            <h3 class="tool-title">Encrypted Document Vault</h3>
            <p class="tool-desc">
              Organize IDs, diplomas, tax records, and medical files in structured, biometric-locked folders. Set validity dates to receive private local expiry reminders 30 days before renewal.
            </p>
            <span class="tool-link-text">Explore vault folder templates →</span>
          </div>
        </a>

        <!-- Tool 7: Private Document Scanner -->
        <a href="/document-scanner" class="card tool-feature-card">
          <div class="tool-icon">📄</div>
          <div class="tool-body">
            <div class="tool-badge">SCANNER SUITE</div>
            <h3 class="tool-title">Private Document Scanner</h3>
            <p class="tool-desc">
              Real-time automatic edge detection and perspective quad straightening. Includes shadow removal, high-contrast B&W filters, and offline OCR for Latin and Devanagari scripts with zero watermarks.
            </p>
            <span class="tool-link-text">Read document scanner guide →</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       US & INDIAN PORTAL COMPLIANCE SECTION
       ========================================================================= -->
  <section class="section">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-eyebrow">REAL-WORLD APPLICATION SUCCESS</span>
        <h2 class="section-title">Built for the World's Toughest Upload Portals</h2>
        <p class="section-subtitle">
          Government job portals, consular visa systems, and universities reject applications when dimensions or file weights are off by even a fraction. IDSnap is pre-tuned for both US and Indian standards.
        </p>
      </div>

      <div class="grid grid-2">
        <!-- Column 1: Indian Portals -->
        <div class="card portal-card">
          <div class="portal-badge">INDIAN GOVERNMENT & UNIVERSITIES</div>
          <h3 class="portal-title">UPSC, SSC, NTA & State PSC Portals</h3>
          <p class="portal-desc">
            Candidate registration portals (UPSC OTR, SSC, JEE, NEET, Banking IBPS) enforce rigid, low file caps designed for legacy database pipelines:
          </p>
          <ul class="portal-checklist">
            <li><strong>Passport Photo:</strong> 3.5 × 4.5 cm, strictly between 20 KB and 50 KB.</li>
            <li><strong>Ink Signature:</strong> Thresholded ink on white BG, strictly between 10 KB and 20 KB.</li>
            <li><strong>Certificate Proofs:</strong> Multi-page marksheet and caste PDFs strictly ≤ 200 KB or 300 KB.</li>
            <li><strong>Aadhaar / Voter ID:</strong> Front and back merged on a single A4 page with anti-misuse purpose watermark.</li>
          </ul>
        </div>

        <!-- Column 2: US & Consular Portals -->
        <div class="card portal-card">
          <div class="portal-badge">US & INTERNATIONAL CONSULATES</div>
          <h3 class="portal-title">US Visa DS-160, Green Card & Passport</h3>
          <p class="portal-desc">
            The US Department of State and international embassies mandate strict photographic and geometric compliance:
          </p>
          <ul class="portal-checklist">
            <li><strong>DS-160 Digital Photo:</strong> Exactly 2 × 2 inches (600 × 600 px up to 1200 × 1200 px).</li>
            <li><strong>File Weight:</strong> Compressed JPEG strictly ≤ 240 KB.</li>
            <li><strong>Biometric Head Ratio:</strong> On-screen oval guide ensures head height covers 50% to 69% of the frame.</li>
            <li><strong>Printable Sheets:</strong> 4 × 6 inch photo studio sheets ready for Costco, Walgreens, or local photo kiosks.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       ZERO CLOUD COMPARISON SECTION
       ========================================================================= -->
  <section class="section bg-subtle">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-eyebrow">HONEST COMPARISON</span>
        <h2 class="section-title">Why Users Switch from Cloud Scanning Apps</h2>
        <p class="section-subtitle">
          Big tech scanner apps lock basic tools behind mandatory accounts, upload private documents to remote cloud storage, and charge recurring monthly subscriptions.
        </p>
      </div>

      <div class="comparison-table-wrap">
        <table class="comparison-table">
          <thead>
            <tr>
              <th>Feature / Guarantee</th>
              <th class="col-highlight">IDSnap Studio</th>
              <th>CamScanner</th>
              <th>Adobe Scan</th>
              <th>Web PDF Portals</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Account / Login Required?</strong></td>
              <td class="col-highlight positive">Never (0 Accounts)</td>
              <td class="negative">Forces Login</td>
              <td class="negative">Mandatory Adobe ID</td>
              <td class="negative">Email Gated</td>
            </tr>
            <tr>
              <td><strong>Cloud Document Upload</strong></td>
              <td class="col-highlight positive">Never (Stays on Device)</td>
              <td class="negative">Uploaded to Cloud</td>
              <td class="negative">Saved to Cloud</td>
              <td class="negative">Uploaded to Web Server</td>
            </tr>
            <tr>
              <td><strong>Internet Permissions in OS</strong></td>
              <td class="col-highlight positive">0 Permissions Requested</td>
              <td class="negative">Full Internet Access</td>
              <td class="negative">Full Internet Access</td>
              <td class="negative">Full Internet Access</td>
            </tr>
            <tr>
              <td><strong>ID Card (Front & Back on 1 A4)</strong></td>
              <td class="col-highlight positive">Included Free</td>
              <td class="negative">Paid Subscription Only</td>
              <td class="negative">Manual Editing</td>
              <td class="negative">Not Supported</td>
            </tr>
            <tr>
              <td><strong>Passport Photo Biometric Studio</strong></td>
              <td class="col-highlight positive">Included Free</td>
              <td class="negative">Paid Add-on</td>
              <td class="negative">Not Supported</td>
              <td class="negative">Separate Paid Service</td>
            </tr>
            <tr>
              <td><strong>Target Size ("Under 200 KB")</strong></td>
              <td class="col-highlight positive">Binary Search Engine</td>
              <td class="negative">Guesswork Sliders</td>
              <td class="negative">Requires Acrobat Pro</td>
              <td class="negative">Random Quality Loss</td>
            </tr>
            <tr>
              <td><strong>Offline 2FA Authenticator</strong></td>
              <td class="col-highlight positive">Hardware KeyStore (RFC 6238)</td>
              <td class="negative">None</td>
              <td class="negative">None</td>
              <td class="negative">None</td>
            </tr>
            <tr>
              <td><strong>Ads & Watermarks</strong></td>
              <td class="col-highlight positive">Zero Ads · Zero Watermarks</td>
              <td class="negative">Heavy Ads & Watermarks</td>
              <td class="negative">Marketing Prompts</td>
              <td class="negative">Pop-up Video Ads</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECURITY ARCHITECTURE: AIRPLANE MODE VERIFICATION
       ========================================================================= -->
  <section class="section">
    <div class="container security-architecture-block">
      <div class="security-copy">
        <span class="section-eyebrow">VERIFIED PRIVACY</span>
        <h2 class="section-title">Tested in Airplane Mode. Enforced by the Operating System.</h2>
        <p class="section-lead">
          We don't ask you to trust a vague marketing promise. IDSnap's privacy architecture is guaranteed by physical constraints:
        </p>

        <div class="security-points-list">
          <div class="sec-point">
            <span class="sec-icon">✈️</span>
            <div>
              <strong>Airplane-Mode Tested:</strong>
              <p>Every single feature—from camera scanning and OCR to PDF compression and 2FA code generation—works with Wi-Fi and mobile data completely switched off.</p>
            </div>
          </div>

          <div class="sec-point">
            <span class="sec-icon">🛡️</span>
            <div>
              <strong>Zero INTERNET Permission:</strong>
              <p>Our Android production release manifest omits the <code>android.permission.INTERNET</code> permission. The operating system physically prevents the app from sending any data packets.</p>
            </div>
          </div>

          <div class="sec-point">
            <span class="sec-icon">🔒</span>
            <div>
              <strong>Hardware KeyStore & Enclave:</strong>
              <p>Biometric locks and 2FA secret seeds are sealed inside your device's physical cryptographic security chip using AES-256 encryption.</p>
            </div>
          </div>

          <div class="sec-point">
            <span class="sec-icon">📦</span>
            <div>
              <strong>Total Data Independence:</strong>
              <p>One-tap export creates a clean, password-encrypted ZIP archive with all your files and a metadata manifest. No proprietary lock-in.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="security-badge-visual">
        <div class="shield-graphic-card">
          <div class="shield-circle">
            <svg viewBox="0 0 64 64" fill="none" width="64" height="64">
              <rect width="64" height="64" rx="16" fill="#2457D6"/>
              <path d="M32 16L46 22V34C46 42.5 40 50 32 53C24 50 18 42.5 18 34V22L32 16Z" fill="#0E8A7E"/>
              <path d="M28 32L31 35L37 28" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <h3 class="shield-card-title">Zero Cloud Telemetry</h3>
          <p class="shield-card-desc">No accounts, no analytics SDKs tracking your documents, and zero third-party marketing tags.</p>
          <div class="shield-checklist">
            <span class="pill-check">✓ Offline OCR</span>
            <span class="pill-check">✓ Local Storage</span>
            <span class="pill-check">✓ Biometric Gate</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       FAQ SECTION (WITH JSON-LD SCHEMA FOR GOOGLE SEARCH)
       ========================================================================= -->
  <section id="faq" class="section bg-subtle">
    <div class="container max-w-reading">
      <div class="section-header text-center">
        <span class="section-eyebrow">COMMON QUESTIONS</span>
        <h2 class="section-title">Frequently Asked Questions</h2>
        <p class="section-subtitle">Transparent answers about our offline tools, privacy, and technical operations.</p>
      </div>

      <div class="faq-accordion-list">
        {faqItems.map((item, index) => (
          <details class="card faq-item" id={`faq-${index}`}>
            <summary class="faq-question">
              <span>{item.question}</span>
              <span class="faq-icon">+</span>
            </summary>
            <div class="faq-answer">
              <p>{item.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- =========================================================================
       BOTTOM CTA SECTION
       ========================================================================= -->
  <section class="section bg-primary text-white text-center">
    <div class="container max-w-reading">
      <div class="badge-pill hero-badge" style="background: rgba(255,255,255,0.2); color: #fff; margin: 0 auto 1.5rem auto;">
        Available Now on Google Play
      </div>
      <h2 class="cta-title">Take control of your personal documents & identity</h2>
      <p class="cta-lead">
        Ditch sketchy cloud scanners for a private, on-device studio that respects your time and your data.
      </p>

      <div class="cta-btn-wrap">
        <a href={playStoreUrl} target="_blank" rel="noopener noreferrer" class="btn btn-light btn-lg">
