            </svg>
            App Store
          </a>
        </div>

        <div class="hero-trust-indicators">
          <div class="trust-item">
            <span class="trust-icon">✓</span>
            <span>No Account Required</span>
          </div>
          <div class="trust-item">
            <span class="trust-icon">✓</span>
            <span>Works in Airplane Mode</span>
          </div>
          <div class="trust-item">
            <span class="trust-icon">✓</span>
            <span>Encrypted on Your Phone</span>
          </div>
        </div>
      </div>

      <!-- Hero Phone UI Mockup Showcase -->
      <div class="hero-mockup-wrapper">
        <div class="phone-mockup">
          <div class="phone-notch"></div>
          <div class="phone-screen">
            <!-- App Bar Mockup -->
            <div class="app-mock-header">
              <div class="mock-brand">
                <span class="mock-dot"></span>
                <strong>IDSnap</strong>
              </div>
              <span class="mock-pill">Offline Vault</span>
            </div>

            <!-- Identity Card Showcase Widget -->
            <div class="mock-card id-card-preview">
              <div class="mock-card-header">
                <span class="mock-tag"><svg class="icon-inline" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="3"></rect><circle cx="9" cy="10" r="2"></circle><line x1="15" y1="8" x2="17" y2="8"></line><line x1="15" y1="12" x2="17" y2="12"></line><line x1="7" y1="16" x2="17" y2="16"></line></svg> ID Card Mode</span>
                <span class="mock-status">1 A4 Page Ready</span>
              </div>
              <div class="mock-id-sheets">
                <div class="mock-id-face front">
                  <div class="mock-avatar"></div>
                  <div class="mock-lines">
                    <div class="line l1"></div>
                    <div class="line l2"></div>
                  </div>
                  <span class="face-label">FRONT</span>
                </div>
                <div class="mock-id-face back">
                  <div class="mock-barcode"></div>
                  <span class="face-label">BACK</span>
                </div>
              </div>
            </div>

            <!-- 2FA Authenticator Showcase Widget -->
            <div class="mock-card totp-preview">
              <div class="mock-card-header">
                <span class="mock-tag"><svg class="icon-inline" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><circle cx="12" cy="11" r="2"></circle><path d="M12 13v3"></path></svg> 2FA Authenticator</span>
                <div class="mock-timer-circle">
                  <span class="timer-sec">28s</span>
                </div>
              </div>
              <div class="totp-row">
                <div class="totp-info">
                  <span class="totp-account">Salesforce Enterprise</span>
                  <span class="totp-user">alex@company.com</span>
                </div>
                <div class="totp-code">
                  <code>584 920</code>
                </div>
              </div>
            </div>

            <!-- Everyday Tool Widget -->
            <div class="mock-card tool-preview">
              <div class="mock-card-header">
                <span class="mock-tag"><svg class="icon-inline" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 14 10 14 10 20"></polyline><polyline points="20 10 14 10 14 4"></polyline><line x1="14" y1="10" x2="21" y2="3"></line><line x1="3" y1="21" x2="10" y2="14"></line></svg> Target Compressor</span>
                <span class="mock-badge-success">Saved 92%</span>
              </div>
              <div class="compress-stats">
                <span class="stat-old">4.2 MB</span>
                <span class="stat-arrow">→</span>
                <span class="stat-new">184 KB</span>
                <span class="stat-portal">(Portal Ready)</span>
              </div>
            </div>

            <!-- Bottom Mock Nav -->
            <div class="mock-bottom-nav">
              <div class="nav-item active"><svg class="icon-inline" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg> Home</div>
              <div class="nav-item"><svg class="icon-inline" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="3"></rect><circle cx="9" cy="10" r="2"></circle><line x1="15" y1="8" x2="17" y2="8"></line><line x1="15" y1="12" x2="17" y2="12"></line><line x1="7" y1="16" x2="17" y2="16"></line></svg> Identity</div>
              <div class="nav-item"><svg class="icon-inline" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><circle cx="12" cy="11" r="2"></circle><path d="M12 13v3"></path></svg> 2FA</div>
              <div class="nav-item"><svg class="icon-inline" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg> Tools</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       ZERO CLOUD COMPARISON SECTION
       ========================================================================= -->
  <section class="section comparison-section">
    <div class="container">
      <div class="section-header">
        <span class="badge-pill">Private by Design</span>
        <h2>Why IDSnap is Built Different</h2>
        <p>Big tech scanner apps lock basic tools behind accounts, cloud syncs, and expensive monthly subscriptions. IDSnap keeps your documents on your phone, with no account.</p>
      </div>

      <div class="table-wrap">
        <table class="comparison-matrix">
          <thead>
            <tr>
              <th>Feature / Guarantee</th>
              <th class="col-highlight">IDSnap</th>
              <th>CamScanner</th>
              <th>Adobe Scan</th>
              <th>Web PDF Tools</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Account / Login Required?</strong></td>
              <td class="col-highlight"><span class="badge-pill badge-primary">Never (0 Accounts)</span></td>
              <td>Forces Login</td>
              <td>Mandatory Adobe ID</td>
              <td>Optional / Email gate</td>
            </tr>
            <tr>
              <td><strong>Cloud Document Upload</strong></td>
              <td class="col-highlight"><span class="badge-pill badge-primary">Never (stays on your phone)</span></td>
              <td>Uploaded to Cloud</td>
              <td>Saved to Adobe Cloud</td>
              <td>Uploaded to Web Server</td>
            </tr>
            <tr>
              <td><strong>ID Card (Front+Back on 1 A4)</strong></td>
              <td class="col-highlight">Included (Pro)</td>
              <td>Paid VIP Only</td>
              <td>Manual Stitching</td>
              <td>Not Supported</td>
            </tr>
            <tr>
              <td><strong>Built-in 2FA Authenticator</strong></td>
              <td class="col-highlight">Included (RFC 6238)</td>
              <td>None</td>
              <td>None</td>
              <td>None</td>
            </tr>
            <tr>
              <td><strong>Target Size ("Under 200 KB")</strong></td>
              <td class="col-highlight">Smart Binary Search</td>
              <td>Low/Med/High guesswork</td>
              <td>Requires Acrobat Pro</td>
              <td>Random Quality</td>
            </tr>
            <tr>
              <td><strong>Ad Trackers & Telemetry</strong></td>
              <td class="col-highlight"><span class="badge-pill badge-primary">Zero Trackers</span></td>
              <td>Heavy Advertising</td>
              <td>Analytics & Tracking</td>
              <td>Cookie Trackers</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       PILLAR 1: PHYSICAL IDENTITY SUITE
       ========================================================================= -->
  <section id="identity" class="section identity-section">
    <div class="container">
      <div class="section-header">
        <span class="badge-pill">Pillar 1: Physical Identity</span>
        <h2>Official Identity Docs, Perfected for Submission</h2>
        <p>Built specifically for job seekers, travelers, students, and professionals submitting paperwork to stringent online portals.</p>
      </div>

      <div class="features-grid">
        <div class="card-glass feature-card">
          <div class="feature-icon-badge"><svg class="icon-inline" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="3"></rect><circle cx="9" cy="10" r="2"></circle><line x1="15" y1="8" x2="17" y2="8"></line><line x1="15" y1="12" x2="17" y2="12"></line><line x1="7" y1="16" x2="17" y2="16"></line></svg></div>
          <h3>ID Card Scanner (Front & Back $\rightarrow$ 1 Sheet)</h3>
          <p>
            No more manual collages. Snap the front, flip to snap the back, and IDSnap automatically deskews and positions both sides centered on a single A4/Letter PDF with an optional verification watermark.
          </p>
          <ul class="feature-checklist">
            <li>Standard ISO/IEC 7810 ID-1 card aspect framing</li>
            <li>Automatic shadow removal and contrast enhancement</li>
            <li>Optional "For Verification Only" watermark shield</li>
          </ul>
        </div>

        <div class="card-glass feature-card">
          <div class="feature-icon-badge"><svg class="icon-inline" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path><circle cx="12" cy="13" r="4"></circle></svg></div>
          <h3>Passport-Size Photo Maker</h3>
          <p>
            Crop a portrait to standard photo sizes with on-device face framing, then save it or print a sheet—no photo booth needed.
          </p>
          <ul class="feature-checklist">
            <li><strong>Square photo:</strong> 2 × 2 in (51 × 51 mm) at 300 DPI</li>
            <li><strong>Passport size:</strong> 35 × 45 mm</li>
            <li><strong>More sizes:</strong> 33 × 48 mm, 30 × 40 mm ID photo, 20 × 25 mm stamp size, or a custom size</li>
            <li>Face & eye level guide overlay to ensure compliance</li>
          </ul>
        </div>

        <div class="card-glass feature-card">
          <div class="feature-icon-badge"><svg class="icon-inline" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg></div>
          <h3>Transparent Signature & Stamp Studio</h3>
          <p>
            Sign on paper or directly on screen. IDSnap isolates the ink strokes, wipes the paper background, and produces a crisp, reusable transparent PNG signature.
          </p>
          <ul class="feature-checklist">
            <li>One-tap stamp onto any PDF contract or application form</li>
            <li>Adjustable ink color (deep blue, black, or custom)</li>
            <li>Non-destructive local storage in your private vault</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       PILLAR 2: DIGITAL IDENTITY (2FA AUTHENTICATOR)
       ========================================================================= -->
  <section id="authenticator" class="section authenticator-section">
    <div class="container">
      <div class="pillar-split">
        <div class="pillar-text">
          <span class="badge-pill">Pillar 2: Digital Identity</span>
          <h2>The Offline 2FA Authenticator That Protects Your Logins</h2>
          <p>
            Why juggle separate apps? IDSnap includes a standard RFC 6238 Time-based One-Time Password (TOTP) generator right inside your vault.
          </p>

          <div class="auth-feature-points">
            <div class="point-item">
              <div class="point-num">01</div>
              <div>
                <h4>Instant QR Enrollment</h4>
                <p>Scan <code>otpauth://</code> QR codes from Google, Salesforce, GitHub, AWS, and banking accounts in 1 second.</p>
              </div>
            </div>

            <div class="point-item">
              <div class="point-num">02</div>
              <div>
                <h4>Hardware Enclave Security</h4>
                <p>TOTP secrets are encrypted via Android KeyStore and Apple Keychain. Keys are never exposed in plaintext.</p>
              </div>
            </div>

            <div class="point-item">
              <div class="point-num">03</div>
              <div>
                <h4>Emergency Recovery Codes Vault</h4>
                <p>Store your 8–10 emergency recovery keys securely under each account so you never get locked out of your life.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="pillar-visual">
          <div class="card-glass visual-auth-card">
            <div class="visual-header">
              <div class="pulse-dot"></div>
              <span>Live TOTP Generator (RFC 6238)</span>
            </div>
            
            <div class="auth-demo-list">
              <div class="demo-auth-row">
                <div class="demo-issuer-icon g-icon">G</div>
                <div class="demo-acc-details">
                  <span class="demo-issuer">Google Workspace</span>
                  <span class="demo-email">john.doe@company.com</span>
                </div>
                <div class="demo-code-wrap">
                  <span class="demo-digits">729 401</span>
                  <div class="mini-timer"><span class="timer-bar"></span></div>
                </div>
              </div>

              <div class="demo-auth-row">
                <div class="demo-issuer-icon s-icon"><svg class="icon-inline" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"></path></svg></div>
                <div class="demo-acc-details">
                  <span class="demo-issuer">Salesforce</span>
                  <span class="demo-email">admin@enterprise.org</span>
                </div>
                <div class="demo-code-wrap">
                  <span class="demo-digits">384 192</span>
                  <div class="mini-timer"><span class="timer-bar"></span></div>
                </div>
              </div>

              <div class="demo-auth-row">
                <div class="demo-issuer-icon gh-icon"><svg class="icon-inline" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="18" r="3"></circle><circle cx="6" cy="6" r="3"></circle><circle cx="18" cy="6" r="3"></circle><path d="M18 9v1a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V9"></path><path d="M12 12v3"></path></svg></div>
                <div class="demo-acc-details">
                  <span class="demo-issuer">GitHub Security</span>
                  <span class="demo-email">developer-id</span>
                </div>
                <div class="demo-code-wrap">
                  <span class="demo-digits">902 443</span>
                  <div class="mini-timer"><span class="timer-bar"></span></div>
                </div>
              </div>
            </div>

            <div class="clipboard-notice">
              <svg class="icon-inline" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg> Auto-clears from clipboard in 60s for maximum security
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       PILLAR 3: EVERYDAY PDF & CONVERSION TOOLS
       ========================================================================= -->
  <section id="tools" class="section tools-section">
    <div class="container">
      <div class="section-header">
        <span class="badge-pill">Pillar 3: Everyday PDF Tools</span>
        <h2>Precision Tools That Just Work</h2>
        <p>Every tool you normally need 5 different sketchy websites for, packaged into one clean, honest app.</p>
      </div>

      <div class="tools-bento-grid">
        <div class="card-glass bento-card">
          <div class="bento-icon"><svg class="icon-inline" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 14 10 14 10 20"></polyline><polyline points="20 10 14 10 14 4"></polyline><line x1="14" y1="10" x2="21" y2="3"></line><line x1="3" y1="21" x2="10" y2="14"></line></svg></div>
          <h3>Target-Size PDF & Image Compressor</h3>
          <p>
            Tired of trial and error? Set your exact target file size (e.g. "Under 200 KB" or "Under 500 KB"). IDSnap uses binary search image compression to guarantee your file gets accepted.
          </p>
        </div>

        <div class="card-glass bento-card">
          <div class="bento-icon"><svg class="icon-inline" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg></div>
          <h3>On-Device OCR & Searchable PDFs</h3>
          <p>
            Extract text from photos, documents, and books offline. Latin and Devanagari text models are built in. Create searchable PDFs with an invisible selectable text layer.
          </p>
        </div>

        <div class="card-glass bento-card">
          <div class="bento-icon"><svg class="icon-inline" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg></div>
          <h3>Merge, Split & Organize PDFs</h3>
          <p>
            Reorder pages with drag-and-drop, rotate upside-down pages, delete unwanted annexures, or combine multiple PDFs into one unified file in seconds.
          </p>
        </div>

        <div class="card-glass bento-card">
          <div class="bento-icon"><svg class="icon-inline" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path></svg></div>
          <h3>Multi-Format Offline Converter</h3>
