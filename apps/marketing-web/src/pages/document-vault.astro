---
import Layout from '../layouts/Layout.astro';

const playStoreUrl = "https://play.google.com/store/apps/details?id=com.idsnap.app&hl=en";

const pageTitle = "Encrypted Document Vault & Identity Organizer | On-Device Folder Privacy | IDSnap";
const pageDescription = "Organize all sensitive identity cards, tax proofs, medical records, and education degrees in an encrypted, biometric-locked offline vault. Features local expiry reminders and zero cloud sync.";

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "IDSnap Encrypted Document Vault",
    "operatingSystem": "Android",
    "applicationCategory": "ProductivityApplication",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "description": pageDescription,
    "url": "https://idsnap.app/document-vault",
    "downloadUrl": playStoreUrl,
    "featureList": [
      "Smart folder templates: IDs & Proofs, Education, Medical, Vehicles, Tax, Legal",
      "Unlimited nested custom folders with individual biometric or PIN locks",
      "Document expiration date tracking with local device reminders (30d and 7d)",
      "FLAG_SECURE snapshot protection blocks app switcher snooping",
      "One-tap AES-256 encrypted local backup with zero vendor lock-in",
      "Local encrypted database: documents are never uploaded, and there are never ads in the vault"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Secure and Organize Your Critical Life Documents Offline",
    "description": "Step-by-step guide to organizing passports, licences, diplomas, and health records into biometric-locked local folders.",
    "step": [
      {
        "@type": "HowToStep",
        "name": "Scan or Import Documents",
        "text": "Capture ID cards (front & back), multi-page contracts, or import existing PDFs into IDSnap. Everything is stored in local app storage."
      },
      {
        "@type": "HowToStep",
        "name": "Assign Categories & Expiry Dates",
        "text": "File documents into intuitive templates (IDs, Education, Health, Tax). Add expiration dates to passports or vehicle insurance policies for automatic local reminders."
      },
      {
        "@type": "HowToStep",
        "name": "Enable Biometric App & Folder Lock",
        "text": "Protect individual folders or the entire vault with your phone's native fingerprint or face biometric lock."
      },
      {
        "@type": "HowToStep",
        "name": "Export Data Independence Backup",
        "text": "Export a structured, password-protected ZIP archive anytime to your personal storage without being trapped in proprietary cloud ecosystems."
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Can cloud providers or hackers access documents in my IDSnap Vault?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No. IDSnap has no back-end server, no user accounts, and no sync engine. Documents remain on your handset's internal storage, encrypted. The app is free and shows Google ads on a few screens, never in the vault, and the ad software never sees your documents."
        }
      },
      {
        "@type": "Question",
        "name": "How do document expiration reminders work offline?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "When you input an expiration date for your passport, driving license, or insurance policy, IDSnap schedules local notifications using the device's native alarm manager. No network connection is ever needed."
        }
      },
      {
        "@type": "Question",
        "name": "What categories come pre-configured in IDSnap Vault?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "IDSnap provides sensible, country-neutral templates: IDs & Proofs, Education & Career, Medical & Health, Vehicles & Insurance, Tax & Receipts, Home & Legal, Travel, and Work. You can also create unlimited custom nested folders."
        }
      },
      {
        "@type": "Question",
        "name": "Is my data locked into IDSnap?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Never. IDSnap believes in complete Data Independence. With one tap, you can export all your documents as standard PDF files inside their organized category folders, accompanied by a clean manifest.json summary."
        }
      }
    ]
  }
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical="https://idsnap.app/document-vault"
  schema={schemaData}
>
  <!-- Hero Section -->
  <section class="tool-hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <div class="badge-row">
          <span class="badge badge-primary">Encrypted Local Vault</span>
          <span class="badge badge-neutral">Biometric Folder Lock</span>
        </div>
        <h1 class="hero-title">
          Keep your most sensitive documents <span class="highlight">organized, locked & strictly on-device.</span>
        </h1>
        <p class="hero-lead">
          From passports and marksheets to vehicle insurance and medical records—store and protect your family's vital documents in an organized offline vault. No cloud leaks, no account needed, and never an ad inside your vault.
        </p>

        <div class="cta-actions">
          <a href={playStoreUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
              <path d="M3.609 1.814L13.793 12 3.61 22.186a2.235 2.235 0 0 1-.61-.318c-.469-.34-.75-.89-.75-1.488V3.62c0-.598.281-1.148.75-1.488.196-.142.408-.25.61-.318zm11.603 11.603l2.607-2.607-12.01-6.93 9.403 9.537zm0 1.166l-9.403 9.537 12.01-6.93-2.607-2.607zm1.166-1.166l3.208 1.852c.983.567.983 1.493 0 2.06l-3.208 1.852V13.417z"/>
            </svg>
            <span>Download on Google Play</span>
          </a>
          <a href="#vault-categories" class="btn btn-secondary btn-lg">Explore Categories</a>
        </div>

        <div class="trust-metrics">
          <div class="metric">
            <span class="metric-val">Biometric</span>
            <span class="metric-label">Fingerprint & PIN</span>
          </div>
          <div class="metric-divider"></div>
          <div class="metric">
            <span class="metric-val">Local 30d</span>
            <span class="metric-label">Expiry Reminders</span>
          </div>
          <div class="metric-divider"></div>
          <div class="metric">
            <span class="metric-val">ZIP Export</span>
            <span class="metric-label">Data Independence</span>
          </div>
        </div>
      </div>

      <div class="hero-preview">
        <div class="vault-mockup-card">
          <div class="vault-header">
            <div class="vault-header-title">
              <span class="vault-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
                </svg>
              </span>
              <div>
                <span class="vault-title-text">Personal Document Vault</span>
                <span class="vault-meta-text">6 categories · 18 documents</span>
              </div>
            </div>
            <span class="vault-lock-badge">
              <svg class="icon-inline" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
              </svg>
              LOCKED
            </span>
          </div>

          <div class="vault-folder-grid">
            <!-- Folder 1 -->
            <div class="vault-folder-item active">
              <div class="folder-icon-row">
                <span class="folder-emoji">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="16" rx="2"/>
                    <line x1="7" y1="9" x2="11" y2="9"/>
                    <line x1="7" y1="13" x2="17" y2="13"/>
                  </svg>
                </span>
                <span class="file-count">4 items</span>
              </div>
              <span class="folder-name">IDs & Proofs</span>
              <span class="folder-sub">Passport, National ID, DL</span>
            </div>

            <!-- Folder 2 -->
            <div class="vault-folder-item">
              <div class="folder-icon-row">
                <span class="folder-emoji">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
                    <path d="M6 12v5c3 3 9 3 12 0v-5"/>
                  </svg>
                </span>
                <span class="file-count">5 items</span>
              </div>
              <span class="folder-name">Education & Career</span>
              <span class="folder-sub">Degrees, Transcripts</span>
            </div>

            <!-- Folder 3 -->
            <div class="vault-folder-item alert-border">
              <div class="folder-icon-row">
                <span class="folder-emoji">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="9" rx="2"/>
                    <circle cx="7.5" cy="16.5" r="1.5"/>
                    <circle cx="16.5" cy="16.5" r="1.5"/>
                    <path d="M5 11l2-6h10l2 6"/>
                  </svg>
                </span>
                <span class="file-count">3 items</span>
              </div>
              <span class="folder-name">Vehicles & Insurance</span>
              <span class="expiry-alert">Expires in 18 days</span>
            </div>

            <!-- Folder 4 -->
            <div class="vault-folder-item">
              <div class="folder-icon-row">
                <span class="folder-emoji">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
                  </svg>
                </span>
                <span class="file-count">4 items</span>
              </div>
              <span class="folder-name">Medical & Health</span>
              <span class="folder-sub">Vaccines, Prescriptions</span>
            </div>
          </div>

          <div class="vault-card-footer">
            <div class="backup-status">
              <span>Encrypted Local Storage (SQLite + Jetpack)</span>
              <span class="dot-ok">● Airplane-Mode Verified</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Categories Section -->
  <section id="vault-categories" class="section bg-subtle">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-eyebrow">ORGANIZATION THAT MAKES SENSE</span>
        <h2 class="section-title">A Dedicated Home for Every Essential Document</h2>
        <p class="section-subtitle">
          Instead of scattering photos across chat apps, galleries, and download folders, IDSnap gives you pre-structured, search-ready categories.
        </p>
      </div>

      <div class="grid grid-3">
        <!-- Category 1 -->
        <div class="card category-card">
          <div class="cat-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="16" rx="2"/>
              <line x1="7" y1="9" x2="11" y2="9"/>
              <line x1="7" y1="13" x2="17" y2="13"/>
            </svg>
          </div>
          <h3 class="card-title">IDs & Proofs</h3>
          <p class="card-text">
            Keep your National ID, Passport, Driver’s Licence, Voter ID, and Tax numbers organized. Tapping an empty slot launches the matching 2-step card scanner.
          </p>
        </div>

        <!-- Category 2 -->
        <div class="card category-card">
          <div class="cat-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
              <path d="M6 12v5c3 3 9 3 12 0v-5"/>
            </svg>
          </div>
          <h3 class="card-title">Education & Career</h3>
          <p class="card-text">
            Consolidate high school marksheets, bachelor's degrees, employment offer letters, and professional certifications in high-contrast searchable PDFs.
          </p>
        </div>

        <!-- Category 3 -->
        <div class="card category-card">
          <div class="cat-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
            </svg>
          </div>
          <h3 class="card-title">Medical & Health</h3>
          <p class="card-text">
            Keep doctor prescriptions, lab diagnostic reports, health insurance membership cards, and vaccination histories ready for emergencies.
          </p>
        </div>

        <!-- Category 4 -->
        <div class="card category-card">
          <div class="cat-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="9" rx="2"/>
              <circle cx="7.5" cy="16.5" r="1.5"/>
              <circle cx="16.5" cy="16.5" r="1.5"/>
              <path d="M5 11l2-6h10l2 6"/>
            </svg>
          </div>
          <h3 class="card-title">Vehicles & Insurance</h3>
          <p class="card-text">
            Store vehicle registration certificates (RC), pollution checks (PUC), and motor insurance policies. Set expiration dates to get timely renewal alerts.
          </p>
        </div>

        <!-- Category 5 -->
        <div class="card category-card">
          <div class="cat-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1-2-1z"/>
              <line x1="8" y1="7" x2="16" y2="7"/>
              <line x1="8" y1="11" x2="16" y2="11"/>
              <line x1="8" y1="15" x2="12" y2="15"/>
            </svg>
          </div>
          <h3 class="card-title">Tax & Receipts</h3>
          <p class="card-text">
            Archive annual tax returns, payroll salary slips, home rent agreements, and major electronics warranty receipts for tax deduction season.
          </p>
        </div>

        <!-- Category 6 -->
        <div class="card category-card">
          <div class="cat-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
              <polyline points="9 22 9 12 15 12 15 22"/>
            </svg>
          </div>
          <h3 class="card-title">Home & Legal</h3>
          <p class="card-text">
            Protect apartment rental agreements, land title records, notarized affidavits, and utility bill address proofs behind biometric locks.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Feature Deep-Dive: Expiry Reminders & Biometrics -->
  <section class="section">
    <div class="container feature-deepdive">
      <div class="deepdive-copy">
        <span class="section-eyebrow">NEVER MISS A RENEWAL</span>
        <h2 class="section-title">Local expiry reminders that never touch the cloud</h2>
        <p>
          Passports expire, car insurances lapse, and driving licenses require periodic renewals. IDSnap tracks document deadlines without uploading your private papers to a third-party calendar or cloud server.
        </p>

        <div class="reminder-steps">
          <div class="reminder-step-item">
            <span class="step-badge">1</span>
            <div>
              <strong>Assign Expiration Date:</strong>
              <p>When saving any scan or document, simply set its validity expiration date.</p>
            </div>
          </div>
          <div class="reminder-step-item">
            <span class="step-badge">2</span>
            <div>
              <strong>Local Push Notifications:</strong>
              <p>Your phone schedules private local notifications at 30 days and 7 days prior to expiry.</p>
            </div>
          </div>
          <div class="reminder-step-item">
            <span class="step-badge">3</span>
            <div>
              <strong>One-Tap Renewal Prep:</strong>
              <p>Tap the notification to view the document and launch the matching passport photo or scan tool for renewal forms.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="deepdive-media">
        <div class="reminder-mockup">
          <div class="notif-card">
            <div class="notif-header">
              <span class="app-tag">IDSNAP DOCUMENT REMINDER</span>
              <span class="notif-time">Now</span>
            </div>
            <div class="notif-body">
              <span class="notif-bell">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                  <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                </svg>
              </span>
              <div>
                <span class="notif-title">Motor Insurance Policy Expiring</span>
                <span class="notif-desc">Your policy expires in 7 days (Oct 24). Tap to view policy number and renew.</span>
              </div>
            </div>
          </div>

          <div class="notif-card second">
            <div class="notif-header">
              <span class="app-tag">IDSNAP DOCUMENT REMINDER</span>
              <span class="notif-time">30d reminder</span>
            </div>
            <div class="notif-body">
              <span class="notif-bell">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="3" width="18" height="18" rx="2"/>
                  <circle cx="12" cy="10" r="3"/>
                  <line x1="7" y1="17" x2="17" y2="17"/>
                </svg>
              </span>
              <div>
                <span class="notif-title">Passport Renewal Due Soon</span>
                <span class="notif-desc">Passport validity reaches 6-month threshold in 30 days. Prep your 35×45mm photos now.</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Data Independence Export -->
  <section class="section bg-subtle">
    <div class="container max-w-reading text-center">
      <span class="section-eyebrow">DATA INDEPENDENCE</span>
      <h2 class="section-title">Your Documents Belong to You. Not Us.</h2>
      <p class="section-lead">
        Most cloud scanning apps trap your files in proprietary databases to force you into paying subscription fees. IDSnap is built on the philosophy of full data sovereignty.
      </p>

      <div class="export-callout-card">
        <div class="callout-icon">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
            <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
            <line x1="12" y1="22.08" x2="12" y2="12"/>
          </svg>
        </div>
        <div class="callout-content">
          <h3>One-Tap ZIP Backup with manifest.json</h3>
          <p>
            At any moment, tap <strong>Export All</strong> to produce a clean, organized ZIP archive containing all your original PDFs sorted into their respective category folders, accompanied by a clean metadata manifest.
          </p>
          <div class="export-tags">
            <span class="export-tag">
              <svg class="icon-inline" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
              Standard PDF Format
            </span>
            <span class="export-tag">
              <svg class="icon-inline" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
              Password Encrypted ZIP
            </span>
            <span class="export-tag">
              <svg class="icon-inline" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
              Zero Account Lock-in
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="section">
    <div class="container max-w-reading">
      <div class="section-header text-center">
        <span class="section-eyebrow">QUESTIONS & ANSWERS</span>
        <h2 class="section-title">Frequently Asked Questions</h2>
      </div>

      <div class="faq-accordion">
        <div class="faq-item">
          <h3 class="faq-question">Can I create my own custom folders inside the Vault?</h3>
          <div class="faq-answer">
            <p>
              Yes! While IDSnap ships with useful default templates, you can create unlimited custom folders, sub-folders, and apply custom biometric lock policies to any folder.
            </p>
          </div>
        </div>

        <div class="faq-item">
          <h3 class="faq-question">What happens when someone opens the app on my phone?</h3>
          <div class="faq-answer">
            <p>
              If you enable App Lock or Folder Lock, IDSnap prompts for your biometric fingerprint, face unlock, or device PIN before displaying any thumbnails or document contents.
            </p>
          </div>
        </div>

        <div class="faq-item">
          <h3 class="faq-question">Can other apps on my phone read the files in IDSnap Vault?</h3>
          <div class="faq-answer">
            <p>
              No. Documents scanned or saved in IDSnap are stored within the app's sandboxed private storage directory. On modern Android versions, other apps are completely blocked from reading IDSnap's internal data directories.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="section bg-primary text-white text-center">
    <div class="container max-w-reading">
      <h2 class="cta-title">Build your calm, secure personal document vault</h2>
      <p class="cta-lead">
        Protect identity cards, degrees, and certificates on your phone with biometric security. Stored on your phone, free (supported by ads), and private.
      </p>
      <div class="cta-btn-wrap">
        <a href={playStoreUrl} target="_blank" rel="noopener noreferrer" class="btn btn-light btn-lg">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
            <path d="M3.609 1.814L13.793 12 3.61 22.186a2.235 2.235 0 0 1-.61-.318c-.469-.34-.75-.89-.75-1.488V3.62c0-.598.281-1.148.75-1.488.196-.142.408-.25.61-.318zm11.603 11.603l2.607-2.607-12.01-6.93 9.403 9.537zm0 1.166l-9.403 9.537 12.01-6.93-2.607-2.607zm1.166-1.166l3.208 1.852c.983.567.983 1.493 0 2.06l-3.208 1.852V13.417z"/>
          </svg>
          <span>Download Free on Google Play</span>
        </a>
      </div>
      <p class="cta-subtext">No subscriptions · Free, supported by ads · Complete Data Independence</p>
    </div>
  </section>
</Layout>

<style>
  .tool-hero {
    padding: 4rem 0 3rem;
    background: linear-gradient(180deg, var(--surface-subtle) 0%, var(--surface) 100%);
    border-bottom: 1px solid var(--border-subtle);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 3.5rem;
    align-items: center;
  }
  .badge-row {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
