# IDSnap licence server configuration. Copy to .env (git-ignored) for local
# runs; in production set these in your host's secret manager. NEVER commit
# real values.

# 180 Pay credentials (180 Developer Console > your app)
ONE_EIGHTY_CLIENT_ID=180_client_xxxxxxxxxxxxxxxx
ONE_EIGHTY_CLIENT_SECRET=180_secret_xxxxxxxxxxxxxxxx
ONE_EIGHTY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx
ONE_EIGHTY_CORE_URL=https://services.180workspace.com
ONE_EIGHTY_PAY_URL=https://pay.180workspace.com

# Ed25519 private seed (base64url). Generate: dart run tool/keygen.dart
LICENSE_SIGNING_KEY=
# Only for local development with the published dev key:
# ALLOW_DEV_KEY=true

# Business rules
TRIAL_HOURS=24
DAY_PRICE_CENTS=10
MONTH_PRICE_CENTS=250
CURRENCY=USD
MIN_DAYS=1
MAX_DAYS=24
MONTHLY_PLAN_CODE=idsnap-monthly
MONTHLY_GRACE_DAYS=3

# Public https address of this server (checkout return page)
PUBLIC_BASE_URL=https://licence.example.com

# Gateway behaviour (see README "VERIFY WITH 180 PAY")
ONE_EIGHTY_CHECKOUT_MODE=api
ONE_EIGHTY_WEBHOOK_AMOUNT_UNIT=major
ONE_EIGHTY_CHECKOUT_HOST_SUFFIX=180workspace.com

# Runtime
PORT=8080
DATABASE_PATH=/data/license.db
# true only behind exactly one trusted reverse proxy that sets X-Forwarded-For
TRUST_PROXY=false
